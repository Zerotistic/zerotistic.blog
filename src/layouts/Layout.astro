---
import "@/styles/reset.css"
import "@/styles/fonts.css"
import "@/styles/color.css"
import "@/styles/typography.css"
import "@/styles/layout.css"
import "@/styles/icon-button.css"
import "@/styles/bar.css"
import "@/styles/shape.css"
import "@/styles/interaction.css"
import "@/styles/editorial.css"

import Footer from "@/components/Footer.astro"
import AvalonBackground from "@/components/AvalonBackground.astro"
import MetaHead from "@/components/MetaHead.astro"
import Sidebar from "@/components/Sidebar.astro"
import TouchFeedback from "@/components/TouchFeedback.astro"
import { SITE } from "@/consts"

type Props = {
  crumbs?: { label: string; href: string }[]
  showArtoria?: boolean
  wide?: boolean
  reading?: boolean
  narrowToc?: boolean
}

const {
  crumbs,
  showArtoria = true,
  wide = false,
  reading = false,
  narrowToc = false,
} = Astro.props
---

<html lang={SITE.locale} dir={SITE.dir}>
  <MetaHead>
    <slot name="head" />
  </MetaHead>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <AvalonBackground />
    <page-grid
      class:list={{ reading, overview: wide || narrowToc, "narrow-toc": narrowToc }}
    >
      <page-header>
        <page-nav>
          <Sidebar crumbs={crumbs} showArtoria={showArtoria}
            ><slot name="actions" slot="actions" /></Sidebar
          >
        </page-nav>
        {Astro.slots.has("toc") && (
            <page-toc><slot name="toc" /></page-toc>
          )}
      </page-header>
      <page-content class:list={{ wide }}>
        <main id="main-content" tabindex="-1"><slot /></main>
        <page-footer><Footer showArtoria={showArtoria} /></page-footer>
      </page-content>
    </page-grid>

    <TouchFeedback />

    <script is:inline>
      console.log(
        "%c zerotistic ",
        "background:#111110;color:#8ea6c8;font-family:monospace;font-weight:600;padding:3px 8px;border-radius:4px",
        "flag{curious_ones_read_the_console} — say hi on discord: zerotistic",
      )
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    inset-block-start: var(--space-xs);
    inset-inline-start: var(--space-xs);
    z-index: 100;
    padding: var(--space-xs) var(--space-s);
    background: var(--background);
    color: var(--foreground);
    border: 1px solid var(--accent);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    transform: translateY(calc(-100% - var(--space-l)));

    &:focus {
      transform: none;
    }
  }

  page-grid {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    gap: var(--grid-gutter);
    max-width: var(--grid-max-width);
    min-height: 100svh;
    margin-inline: auto;
    padding-inline: var(--grid-gutter);
    padding-block-start: var(--page-offset-top);

    @media (width < 64rem) {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      padding-block-start: 0;
    }
  }

  page-header {
    display: contents;

    @media (width < 64rem) {
      display: block;
      grid-column: 1 / -1;
      position: sticky;
      top: 0;
      z-index: 10;
      min-width: 0;
      margin-inline: calc(-1 * var(--grid-gutter));
    }
  }

  page-nav {
    display: block;
    min-width: 0;
    grid-column: 1 / 3;
    grid-row: 1;

    @media screen and (width >= 64rem) {
      position: fixed;
      inset-block: var(--page-offset-top) var(--page-offset-bottom);
      inset-inline-start: var(--grid-edge);
      width: calc(2 * var(--grid-column-width) + var(--grid-gutter));
    }
  }

  page-toc {
    display: block;
    min-width: 0;
    grid-column: 10 / 13;
    grid-row: 1;

    @media screen and (width >= 64rem) {
      position: fixed;
      inset-block: var(--page-offset-top) var(--page-offset-bottom);
      inset-inline-end: var(--grid-edge);
      width: calc(3 * var(--grid-column-width) + 2 * var(--grid-gutter));
    }
  }

  page-content {
    display: flex;
    flex-direction: column;
    grid-column: 3 / 10;
    grid-row: 1;
    min-width: 0;
    max-inline-size: var(--measure);

    &.wide {
      max-inline-size: var(--measure-overview);
    }

    main {
      flex: 1;
    }

    page-footer {
      display: block;
      margin-block-start: var(--space-xl);
    }

    @media (width >= 64rem) {
      &.wide {
        grid-column: 3 / -1;
      }
    }

    @media (width < 64rem) {
      grid-column: 1 / -1;
      grid-row: auto;
      inline-size: 100%;
      margin-inline: auto;
    }
  }

  @media (width >= 64rem) {
    page-grid.narrow-toc {
      page-content {
        grid-column: 3 / -1;
        max-inline-size: calc(
          min(100%, var(--measure-overview)) -
          var(--project-index-width) -
          var(--grid-gutter)
        );
      }

      page-toc {
        grid-column: 11 / 13;
        width: var(--project-index-width);
        inset-inline-end: calc(
          var(--grid-edge) +
          max(
            0px,
            10 *
            var(--grid-column-width) +
            9 *
            var(--grid-gutter) -
            var(--measure-overview)
          )
        );
      }
    }
  }

  @media (width < 64rem) {
    page-grid.overview page-content {
      max-inline-size: var(--measure-overview);
    }

    page-grid.reading {
      row-gap: 0;

      &:has(page-toc) {
        grid-template-rows: auto auto 1fr;
      }

      /* The contents bar sticks to the whole page, not a short header. */
      page-header {
        display: contents;
      }

      page-nav,
      page-toc {
        grid-column: 1 / -1;
        grid-row: auto;
        margin-inline: calc(-1 * var(--grid-gutter));
      }

      page-toc {
        position: sticky;
        top: 0;
        align-self: start;
        z-index: 10;
      }

      page-content {
        margin-block-start: var(--grid-gutter);
      }
    }
  }
</style>
