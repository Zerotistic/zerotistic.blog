---
import { formatDate } from "@/lib/utils"
import { titleHtml } from "@/lib/content"
import type { CollectionEntry } from "astro:content"

type Props = {
  post: CollectionEntry<"blog">
  partCount: number
  tags: string[]
}

const { post, partCount, tags } = Astro.props
---

<li data-post-row data-tags={tags.join(" ")}>
  <article>
    <a class="post-link" href={`/posts/${post.id}`}>
      <row-marker aria-hidden="true">&rsaquo;</row-marker>
      <time datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date)}
      </time>
      <row-title>
        <span set:html={titleHtml(post.data.title)} />
        {partCount > 0 && (
          <series-badge>series · {partCount} parts</series-badge>
        )}
      </row-title>
    </a>
    {tags.length > 0 && (
      <row-tags aria-label="Tags">
        {tags.map((tag) => <a href={`/tags/${tag}`}>#{tag}</a>)}
      </row-tags>
    )}
  </article>
</li>

<style>
  li {
    border-block-start: 1px solid var(--border);

    &:last-child {
      border-block-end: 1px solid var(--border);
    }
  }

  article {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-s);
    padding-block: var(--space-s);
  }

  .post-link {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    text-decoration: none;

    &::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    row-marker {
      position: absolute;
      inset-inline-start: -1rem;
      inset-block-start: var(--space-s);
      font-family: var(--font-mono);
      line-height: calc(var(--leading-offset) + 1em);
      color: var(--accent);
      opacity: 0;
    }

    time {
      grid-row: 1;
      grid-column: 1;
      font-family: var(--font-mono);
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
      color: var(--muted-foreground);
      white-space: nowrap;
    }

    row-title {
      grid-row: 1;
      grid-column: 2;
      font-size: var(--step-0);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);

      > span {
        text-wrap: balance;
      }
    }

    series-badge {
      margin-inline-start: var(--space-2xs);
      padding-inline: var(--space-2xs);
      font-family: var(--font-mono);
      font-size: 0.7em;
      letter-spacing: 0;
      color: var(--muted-foreground);
      white-space: nowrap;
      border: 1px solid var(--border);
      border-radius: var(--radius-full);
    }

    &:hover,
    &:focus-visible {
      row-marker {
        opacity: 1;
      }

      row-title > span {
        text-decoration: underline;
        text-decoration-color: var(--foreground);
        text-underline-offset: 0.2em;
      }
    }
  }

  row-tags {
    z-index: 1;
    grid-row: 2;
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0;

    a {
      color: var(--muted-foreground);
      text-decoration-color: transparent;

      &:hover {
        color: var(--foreground);
      }
    }
  }

  @media (width < 34rem) {
    article {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }

    .post-link {
      grid-template-columns: 1fr;
      row-gap: var(--space-3xs);

      time {
        grid-row: 1;
        grid-column: 1;
      }

      row-title {
        grid-row: 2;
        grid-column: 1;
      }

      row-marker {
        display: none;
      }
    }

    row-tags {
      grid-row: 3;
      grid-column: 1;
    }
  }
</style>
