---
import { formatDate } from "@/lib/utils"
import { titleHtml } from "@/lib/content"
import type { CollectionEntry } from "astro:content"

type Props = {
  post: CollectionEntry<"blog">
  partCount: number
  tags: string[]
  showYear?: boolean
}

const { post, partCount, tags, showYear = true } = Astro.props
---

<li data-post-row data-tags={tags.join(" ")}>
  <article class:list={["editorial-row", { "short-date": !showYear }]}>
    <a class="post-link" href={`/posts/${post.id}`}>
      <time
        datetime={post.data.date.toISOString()}
        aria-label={showYear ? undefined : formatDate(post.data.date)}
      >
        {formatDate(post.data.date, showYear)}
      </time>
      <row-title>
        <span class="row-title" set:html={titleHtml(post.data.title)} />
        {partCount > 0 && (
          <series-badge>series · {partCount} parts</series-badge>
        )}
      </row-title>
      <span class="post-arrow link-arrow" aria-hidden="true">→</span>
    </a>
    {tags.length > 0 && (
      <row-tags aria-label="Tags">
        {tags.map((tag) => <a href={`/tags/${tag}`}>#{tag}</a>)}
      </row-tags>
    )}
  </article>
</li>

<style>
  li {
    border-block-start: 1px solid var(--border);

    &:last-child {
      border-block-end: 1px solid var(--border);
    }
  }

  article {
    position: relative;
    display: grid;
    /* Reserve the same width for dates with one- and two-digit days. */
    grid-template-columns: var(--post-date-width, 7.25rem) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-s);

    &.short-date {
      --post-date-width: 4.25rem;
    }
  }

  .post-link {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    text-decoration: none;

    &::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    @media (any-pointer: coarse) {
      &:focus-visible:active,
      &[data-pressed] {
        background-color: transparent;

        &::after {
          background-color: var(--accent-muted);
        }
      }
    }

    time {
      grid-row: 1;
      grid-column: 1;
      font-family: var(--font-mono);
      font-size: var(--text-meta);
      letter-spacing: 0;
      font-variant-numeric: tabular-nums;
      color: var(--muted-foreground);
      white-space: nowrap;
    }

    row-title {
      grid-row: 1;
      grid-column: 2;
      font-size: var(--step-0);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);

      > span {
        text-wrap: balance;
      }
    }

    series-badge {
      margin-inline-start: var(--space-2xs);
      padding-inline: var(--space-2xs);
      font-family: var(--font-mono);
      font-size: var(--text-caption);
      letter-spacing: 0;
      color: var(--muted-foreground);
      white-space: nowrap;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
    }

    .post-arrow {
      grid-column: 3;
      grid-row: 1;
      font-size: var(--step-0);
    }
  }

  row-tags {
    z-index: 1;
    grid-row: 2;
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0;

    a {
      color: var(--muted-foreground);
      text-decoration-color: transparent;

      &:hover {
        color: var(--foreground);
      }
    }
  }

  @media (width < 34rem) {
    article {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-3xs);
    }

    .post-link {
      grid-template-columns: subgrid;
      row-gap: var(--space-3xs);

      time {
        grid-row: 1;
        grid-column: 1;
      }

      row-title {
        grid-row: 2;
        grid-column: 1;
      }

      .post-arrow {
        grid-column: 2;
        grid-row: 2;
      }
    }

    row-tags {
      grid-row: 3;
      grid-column: 1;
    }
  }
</style>
