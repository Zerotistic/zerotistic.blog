---
type Props = {
  title: string
  description: string
}

const { title, description } = Astro.props
---

<header
  class:list={["page-heading", { "has-aside": Astro.slots.has("aside") }]}
>
  <div class="heading-copy">
    <h1>{title}</h1>
    <p class="description">{description}</p>
    <slot />
  </div>
  {Astro.slots.has("aside") && <div class="heading-aside"><slot name="aside" /></div>}
</header>

<style>
  .page-heading {
    margin-block-end: var(--space-l-xl);
  }

  .has-aside {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-l);
  }

  .heading-copy,
  .heading-aside {
    min-inline-size: 0;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: var(--text-page-title);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .description {
    max-inline-size: 60ch;
    margin-block-start: var(--space-2xs);
    color: var(--muted-foreground);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  @media (width < 40rem) {
    .has-aside {
      gap: var(--space-xs);
    }
  }
</style>
