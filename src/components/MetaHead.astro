---
import sansWoff2 from "@/assets/fonts/IBMPlexSans-VariableFont_wght.woff2?url"
import monoWoff2 from "@/assets/fonts/IBMPlexMono-Regular.woff2?url"
import monoMediumWoff2 from "@/assets/fonts/IBMPlexMono-Medium.woff2?url"
import dayLandscape from "@/assets/optimized/landscape/day.avif?url"
import nightLandscape from "@/assets/optimized/landscape/night.avif?url"
import { SITE } from "@/consts"
---

<head>
  <meta charset="utf-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  >
  <meta name="generator" content={Astro.generator}>

  <meta name="HandheldFriendly" content="True">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content={SITE.title}>
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  >

  <meta
    name="theme-color"
    content="#111110"
    media="(prefers-color-scheme: dark)"
  >
  <meta
    name="theme-color"
    content="#fdfdfc"
    media="(prefers-color-scheme: light)"
  >

  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="sitemap" href="/sitemap-index.xml">
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL("rss.xml", Astro.site)}
  >

  <link rel="preload" href={sansWoff2} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={monoWoff2} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={monoMediumWoff2} as="font" type="font/woff2" crossorigin>

  <script is:inline data-day={dayLandscape} data-night={nightLandscape}>
    (() => {
      const sources = document.currentScript.dataset
      const root = document.documentElement
      root.dataset.js = ""
      try {
        const theme = localStorage.theme
        if (theme === "light" || theme === "dark") root.dataset.theme = theme
      } catch {}
      const systemTheme = matchMedia("(prefers-color-scheme: dark)")
      const landscape = () => {
        const dark = root.dataset.theme === "dark" || (!root.dataset.theme && systemTheme.matches)
        const src = dark ? sources.night : sources.day
        const fallback = dark ? "/static/avalon-landscape-dusk.webp" : "/static/avalon-landscape.webp"
        // Remember each loaded theme to preserve the crossfade when switching.
        // The unused landscape is never requested on initial navigation.
        const candidates = `image-set(url("${src}") type("image/avif"), url("${fallback}") type("image/webp"))`
        const supportsImageSet = CSS.supports("background-image", candidates)
        root.style.setProperty(`--avalon-${dark ? "night" : "day"}-image`, supportsImageSet ? candidates : `url("${fallback}")`)
        return { src: supportsImageSet ? src : fallback, type: supportsImageSet ? "image/avif" : "image/webp" }
      }
      const preload = document.createElement("link")
      preload.rel = "preload"
      preload.as = "image"
      preload.fetchPriority = "high"
      const initial = landscape()
      preload.type = initial.type
      preload.href = initial.src
      document.head.append(preload)
      new MutationObserver(landscape).observe(root, { attributes: true, attributeFilter: ["data-theme"] })
      systemTheme.addEventListener("change", landscape)
    })()
  </script>
  <noscript>
    <style is:inline>
      :root { --avalon-day-image: url("/static/avalon-landscape.webp"); }
      @media (prefers-color-scheme: dark) {
        :root { --avalon-day-image: none; --avalon-night-image: url("/static/avalon-landscape-dusk.webp"); }
      }
    </style>
  </noscript>

  <slot />
</head>
