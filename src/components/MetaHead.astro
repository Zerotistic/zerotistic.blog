---
import sansWoff2 from "@/assets/fonts/IBMPlexSans-VariableFont_wght.woff2?url"
import monoWoff2 from "@/assets/fonts/IBMPlexMono-Regular.woff2?url"
import monoMediumWoff2 from "@/assets/fonts/IBMPlexMono-Medium.woff2?url"
import dayLandscape from "@/assets/optimized/landscape/day.avif?url"
import nightLandscape from "@/assets/optimized/landscape/night.avif?url"
import { SITE } from "@/consts"
---

<head>
  <meta charset="utf-8">
  <!-- viewport-fit=cover lets the page run under Safari's translucent bars
       instead of a solid strip; safe area insets keep the controls clear. -->
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, viewport-fit=cover"
  >
  <meta name="color-scheme" content="light dark">
  <meta name="generator" content={Astro.generator}>
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  >

  <meta
    name="theme-color"
    content="#111110"
    media="(prefers-color-scheme: dark)"
  >
  <meta
    name="theme-color"
    content="#fdfdfc"
    media="(prefers-color-scheme: light)"
  >

  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Pages render in the background while the pointer rests on their
       link, so the click lands on a finished page. Feeds and files skipped. -->
  <script type="speculationrules" is:inline>
    {
      "prerender": [
        {
          "where": {
            "and": [
              { "href_matches": "/*" },
              { "not": { "href_matches": "/*.(xml|pdf|png|jpg|webp|avif|svg|mp4|zip)" } },
              { "not": { "selector_matches": "[download], [rel~=nofollow]" } }
            ]
          },
          "eagerness": "moderate"
        }
      ]
    }
  </script>

  <link rel="sitemap" href="/sitemap-index.xml">
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL("rss.xml", Astro.site)}
  >

  <link rel="preload" href={sansWoff2} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={monoWoff2} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={monoMediumWoff2} as="font" type="font/woff2" crossorigin>

  <script is:inline data-day={dayLandscape} data-night={nightLandscape}>
    (() => {
      const sources = document.currentScript.dataset
      const root = document.documentElement
      root.dataset.js = ""
      // The logo's cursor greets once per visit, not on every page.
      try {
        if (sessionStorage.getItem("cursor-intro")) root.dataset.introPlayed = ""
        else sessionStorage.setItem("cursor-intro", "1")
      } catch {}

      try {
        const theme = localStorage.theme
        if (theme === "light" || theme === "dark") root.dataset.theme = theme
      } catch {}
      const systemTheme = matchMedia("(prefers-color-scheme: dark)")
      // Data saver on or narrow viewport: skip scenery download. The page reads the same.
      const reducedData = matchMedia("(prefers-reduced-data: reduce)").matches
      const wideScenery = matchMedia("(width >= 80rem)")
      const landscape = () => {
        if (reducedData || !wideScenery.matches) return { src: "", type: "" }
        const dark = root.dataset.theme === "dark" || (!root.dataset.theme && systemTheme.matches)
        const src = dark ? sources.night : sources.day
        const fallback = dark ? "/static/avalon-landscape-dusk.webp" : "/static/avalon-landscape.webp"
        // Remember each loaded theme to preserve the crossfade when switching.
        // The unused landscape is never requested on initial navigation.
        const candidates = `image-set(url("${src}") type("image/avif"), url("${fallback}") type("image/webp"))`
        const supportsImageSet = CSS.supports("background-image", candidates)
        root.style.setProperty(`--avalon-${dark ? "night" : "day"}-image`, supportsImageSet ? candidates : `url("${fallback}")`)
        return { src: supportsImageSet ? src : fallback, type: supportsImageSet ? "image/avif" : "image/webp" }
      }
      // The two theme-color metas follow the OS. When the reader picks a
      // theme, both report it so the browser toolbar matches the page.
      // Safari 26 ignores them and tints from the root background instead,
      // which color.css sets explicitly on html.
      const themeColors = document.querySelectorAll('meta[name="theme-color"]')
      const schemeMeta = document.querySelector('meta[name="color-scheme"]')
      const syncTheme = () => {
        const theme = root.dataset.theme
        for (const meta of themeColors) {
          const own = meta.media.includes("dark") ? "#111110" : "#fdfdfc"
          meta.content = theme ? (theme === "dark" ? "#111110" : "#fdfdfc") : own
        }
        schemeMeta.content = theme === "light" || theme === "dark" ? theme : "light dark"
        return landscape()
      }
      const initial = syncTheme()
      // Only hint the decorative scenery on wide desktop viewports, at low
      // priority so it never competes with fonts or hero content.
      if (initial.src) {
        const preload = document.createElement("link")
        preload.rel = "preload"
        preload.as = "image"
        preload.fetchPriority = "low"
        preload.type = initial.type
        preload.href = initial.src
        document.head.append(preload)
      }
      new MutationObserver(syncTheme).observe(root, { attributes: true, attributeFilter: ["data-theme"] })
      systemTheme.addEventListener("change", landscape)
      wideScenery.addEventListener("change", landscape)

      // The shell (build assets, fonts, scenery) comes from disk on a return
      // visit. Registered after load so it never competes with the page.
      if ("serviceWorker" in navigator && !reducedData && location.protocol === "https:")
        addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js", { updateViaCache: "none" }).catch(() => {})
        })
    })()
  </script>
  <noscript>
    <style is:inline>
      @media (width >= 80rem) {
        :root { --avalon-day-image: url("/static/avalon-landscape.webp"); }
        @media (prefers-color-scheme: dark) {
          :root { --avalon-day-image: none; --avalon-night-image: url("/static/avalon-landscape-dusk.webp"); }
        }
      }
    </style>
  </noscript>

  <slot />
</head>
