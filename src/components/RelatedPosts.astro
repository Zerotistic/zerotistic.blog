---
import { getPosts, getSubposts, titleHtml } from "@/lib/content"
import { formatDate, readingTime } from "@/lib/utils"
import type { CollectionEntry } from "astro:content"

type Props = {
  current: CollectionEntry<"blog">
  limit?: number
}

const { current, limit = 3 } = Astro.props

const posts = await getPosts()
const series = await getSubposts()

const tagsFor = (post: CollectionEntry<"blog">) =>
  new Set(
    [post, ...(series.get(post.id) ?? [])].flatMap(
      (entry) => entry.data.tags ?? [],
    ),
  )

const currentTags = tagsFor(current)

const related = posts
  .filter((post) => post.id !== current.id)
  .map((post) => {
    const shared = [...tagsFor(post)].filter((tag) => currentTags.has(tag))
    const chain = [post, ...(series.get(post.id) ?? [])]
    const body = chain.map((entry) => entry.body ?? "").join("\n")
    return {
      post,
      shared,
      readTime: readingTime(body),
    }
  })
  .sort(
    (a, b) =>
      b.shared.length - a.shared.length ||
      b.post.data.date.getTime() - a.post.data.date.getTime(),
  )
  .slice(0, limit)
---

{related.length > 0 && (
  <aside class="related-posts" aria-labelledby="related-posts-heading">
    <h2 id="related-posts-heading" class="related-heading">related posts</h2>
    <ul class="related-list" role="list">
      {related.map(({ post, shared, readTime }) => (
        <li>
          <article class="editorial-row">
            <a class="related-link" href={`/posts/${post.id}/`}>
              <time datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <div class="related-copy">
                <span
                  class="row-title related-title"
                  set:html={titleHtml(post.data.title)}
                />
                <span class="related-meta">
                  {readTime}
                  {shared.length > 0 && (
                    <> · {shared.slice(0, 2).map((tag) => `#${tag}`).join(" ")}</>
                  )}
                </span>
              </div>
              <span class="related-arrow link-arrow" aria-hidden="true">→</span>
            </a>
          </article>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .related-posts {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
  }

  .related-heading {
    margin-block-end: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    letter-spacing: 0;
  }

  .related-list {
    list-style: none;
  }

  li {
    border-block-start: 1px solid var(--border);

    &:first-child {
      border-block-start: 0;
    }
  }

  article {
    position: relative;
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-s);
  }

  .related-link {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    text-decoration: none;

    &::after {
      content: "";
      position: absolute;
      inset: 0;
    }
  }

  time {
    grid-row: 1;
    grid-column: 1;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  .related-copy {
    grid-row: 1;
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-inline-size: 0;
  }

  .related-title {
    font-size: var(--step-0);
    font-weight: var(--font-weight-medium);
    color: var(--foreground);
    text-wrap: balance;
  }

  .related-meta {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0;
    color: var(--muted-foreground);
  }

  .related-arrow {
    grid-row: 1;
    grid-column: 3;
    font-size: var(--step-0);
  }

  @media (width < 34rem) {
    article {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-3xs);
    }

    .related-link {
      row-gap: var(--space-3xs);
    }

    time {
      grid-row: 1;
      grid-column: 1;
    }

    .related-copy {
      grid-row: 2;
      grid-column: 1;
    }

    .related-arrow {
      grid-row: 2;
      grid-column: 2;
    }
  }
</style>
