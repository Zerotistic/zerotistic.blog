<script>
  type CodeBlock = { pre: HTMLElement; scroll: HTMLElement; visible: boolean }
  const blocks = new Map<Element, CodeBlock>()
  const pending = new Set<CodeBlock>()
  let frame = 0

  const flush = () => {
    frame = 0
    // Measure every visible block before writing any styles. Leave distant
    // blocks under content-visibility; reading their size would force layout.
    const measurements = [...pending].filter((block) => block.visible).map((block) => {
      const { scrollLeft, scrollWidth, clientWidth, scrollHeight, clientHeight } = block.pre
      return { ...block, start: scrollLeft > 1, end: scrollWidth - clientWidth - scrollLeft > 1, overflowing: scrollWidth > clientWidth + 1 || scrollHeight > clientHeight + 1 }
    })
    pending.clear()
    for (const { pre, scroll, start, end, overflowing } of measurements) {
      scroll.toggleAttribute("data-overflow-start", start)
      scroll.toggleAttribute("data-overflow-end", end)
      pre.tabIndex = overflowing ? 0 : -1
      if (overflowing) pre.setAttribute("aria-label", "Scrollable code block")
      else pre.removeAttribute("aria-label")
    }
  }
  const schedule = (block: CodeBlock) => {
    if (!block.visible) return
    pending.add(block)
    if (!frame) frame = requestAnimationFrame(flush)
  }
  const visibility = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      const block = blocks.get(entry.target)!
      block.visible = entry.isIntersecting
      schedule(block)
    }
  }, { rootMargin: "300px" })
  const resize = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const block = blocks.get(entry.target)
      if (block) schedule(block)
    }
  })

  // Keep Expressive Code's source-aware copy behavior and success feedback.
  for (const pre of document.querySelectorAll<HTMLElement>("prose-content .expressive-code pre")) {
    const container = pre.closest<HTMLElement>(".expressive-code")
    const codeFrame = pre.closest<HTMLElement>(".frame")
    if (!container || !codeFrame || pre.parentElement?.classList.contains("code-scroll")) continue
    const scroll = document.createElement("div")
    scroll.className = "code-scroll"
    pre.before(scroll)
    scroll.append(pre)
    const block = { pre, scroll, visible: false }
    blocks.set(container, block)
    blocks.set(pre, block)
    visibility.observe(container)
    resize.observe(pre)
    const code = pre.querySelector("code")
    if (code) { blocks.set(code, block); resize.observe(code) }
    const update = () => schedule(block)
    pre.addEventListener("scroll", update, { passive: true })
    codeFrame.addEventListener("toggle", update, true)
    container.addEventListener("contentvisibilityautostatechange", update)

    const button = codeFrame.querySelector<HTMLButtonElement>(".copy button")
    if (button) {
      button.type = "button"
      button.setAttribute("aria-label", "Copy code")
      button.dataset.copied = "Copied"
    }
  }
  document.fonts.ready.then(() => {
    for (const block of new Set(blocks.values())) schedule(block)
  })
</script>

<style is:global>
  prose-content .expressive-code {
    .code-scroll {
      position: relative;
      display: block;
      min-inline-size: 0;

      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-block: 1px;
        inline-size: 1.25rem;
        z-index: 1;
        pointer-events: none;
        opacity: 0;
      }

      &::before {
        inset-inline-start: 1px;
        background: linear-gradient(to right, var(--background), transparent);
      }

      &::after {
        inset-inline-end: 1px;
        background: linear-gradient(to left, var(--background), transparent);
      }

      &[data-overflow-start]::before,
      &[data-overflow-end]::after {
        opacity: 1;
      }
    }

    .copy button {
      background: var(--background);

      &::after {
        margin: 0;
        mask-size: 1rem;
        mask-position: center;
        -webkit-mask-size: 1rem;
        -webkit-mask-position: center;
        background-color: var(--muted-foreground);
      }

      &:focus-visible {
        opacity: 1;
        outline: 2px solid var(--ring);
        outline-offset: 2px;
      }
    }

    .frame:focus-within .copy button {
      opacity: 1;
    }

    .copy .feedback {
      --tooltip-bg: var(--foreground);
      color: var(--background);
      font-family: var(--font-mono);
    }

    @media (any-pointer: coarse), (hover: none) {
      .copy button {
        inline-size: 2.75rem;
        block-size: 2.75rem;
        opacity: 0.85;
      }

      .ec-line:first-child .code {
        padding-inline-end: calc(2.75rem + var(--ec-codePadInl));
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .copy button,
      .copy .feedback {
        transition: none;
      }
    }
  }
</style>
