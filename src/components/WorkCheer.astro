<figure class="work-cheer">
  <button
    class="work-cheer-button"
    type="button"
    aria-label="Say hello to Artoria"
    title="Say hello to Artoria"
    disabled
  >
    <svg
      class="work-cheer-figure"
      viewBox="0 0 480 461"
      width="480"
      height="461"
      role="img"
      aria-labelledby="work-artoria-description"
    >
      <title id="work-artoria-description">
        Artoria excitedly pointing toward HiddenLayer
      </title>
      <defs>
        <!-- The sleeve overlaps at its seam so the shoulder stays anchored. -->
        <clipPath id="work-arm">
          <path d="M0 0H217V209Q246 231 237 259L226 279H0Z" />
        </clipPath>
        <clipPath id="work-ribbon">
          <path d="M407 207 437 210 480 247V300H445L415 247Z" />
        </clipPath>
        <mask
          id="work-body"
          maskUnits="userSpaceOnUse"
          x="0"
          y="0"
          width="480"
          height="461"
        >
          <rect width="480" height="461" fill="white" />
          <path d="M0 0H216V211Q236 232 230 254L219 276H0Z" fill="black" />
          <path d="M414 214 439 216 480 249V300H445L420 244Z" fill="black" />
        </mask>
        <filter id="work-eye-feather">
          <feGaussianBlur stdDeviation="0.8" />
        </filter>
        <mask
          id="work-eyes"
          maskUnits="userSpaceOnUse"
          x="267"
          y="120"
          width="91"
          height="43"
        >
          <ellipse
            cx="283"
            cy="140"
            rx="10"
            ry="14"
            fill="white"
            filter="url(#work-eye-feather)"
          />
          <ellipse
            cx="335"
            cy="141"
            rx="19"
            ry="14"
            fill="white"
            filter="url(#work-eye-feather)"
          />
        </mask>
      </defs>
      <image
        href="/static/work/artoria-pointing.webp"
        width="480"
        height="461"
        mask="url(#work-body)"
      />
      <g class="work-pointing-arm">
        <image
          href="/static/work/artoria-pointing.webp"
          width="480"
          height="461"
          clip-path="url(#work-arm)"
        />
      </g>
      <g class="work-ribbon">
        <image
          href="/static/work/artoria-pointing.webp"
          width="480"
          height="461"
          clip-path="url(#work-ribbon)"
        />
      </g>
      <g class="work-blink" mask="url(#work-eyes)">
        <image
          href="/static/work/artoria-pointing-blink-source.webp"
          width="480"
          height="461"
        />
      </g>
    </svg>
  </button>
  <figcaption>I work here!</figcaption>
  <span class="work-visitor" aria-hidden="true">
    <svg viewBox="0 0 40 32" class="butterfly">
      <g class="wing">
        <path
          d="M20 16C13 0 3 0 3 9c0 7 8 11 17 8C9 14 5 21 10 27c4 5 10-3 10-11Z"
        />
        <path class="wing-vein" d="M20 16 7 7m13 10-9 6" />
        <ellipse class="wing-spot" cx="8" cy="10" rx="1.8" ry="2.5" />
      </g>
      <g class="wing">
        <path
          d="M20 16C27 0 37 0 37 9c0 7-8 11-17 8 11-3 15 4 10 10-4 5-10-3-10-11Z"
        />
        <path class="wing-vein" d="m20 16 13-9m-13 10 9 6" />
        <ellipse class="wing-spot" cx="32" cy="10" rx="1.8" ry="2.5" />
      </g>
      <path class="butterfly-body" d="M20 10v13m0-12-3-5m3 5 3-5" />
    </svg>
  </span>
</figure>

<script>
  import { initWorkCompanion } from "@/lib/work-companion"
  document
    .querySelectorAll<HTMLElement>(".work-cheer")
    .forEach(initWorkCompanion)
</script>

