<button
  type="button"
  id="search-open"
  data-icon-button
  data-tooltip
  aria-label="Search"
  aria-haspopup="dialog"
>
  <svg
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="7" cy="7" r="4.5" />
    <path d="m10.5 10.5 3 3" />
  </svg>
</button>

<dialog id="search" aria-label="Search the site">
  <div class="search-field">
    <svg
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="7" cy="7" r="4.5" />
      <path d="m10.5 10.5 3 3" />
    </svg>
    <input
      type="search"
      role="combobox"
      aria-expanded="true"
      aria-controls="search-results"
      aria-autocomplete="list"
      aria-label="Search posts, sections, CVEs and talks"
      placeholder="search posts, sections, cves…"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
    >
    <kbd class="search-esc">esc</kbd>
  </div>
  <div id="search-results" role="listbox" aria-label="Results"></div>
  <p class="search-help" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
    <span><kbd>enter</kbd> open</span>
    <span>typos are fine</span>
  </p>
  <p class="visually-hidden" role="status" id="search-status"></p>
</dialog>

<script>
  import { closeOnBack } from "@/lib/overlay-history"

  type Kind = "post" | "section" | "cve" | "talk" | "page"
  type Entry = {
    k: Kind
    t: string
    u: string
    c?: string
    m?: string
    x?: string
    i?: string
  }
  type Field = { weight: number; text: string; words: string[] }
  type Doc = Entry & { fields: Field[] }
  type Hit = { doc: Doc; score: number }

  const dialog = document.querySelector<HTMLDialogElement>("#search")!
  const opener = document.querySelector<HTMLButtonElement>("#search-open")!
  const input = dialog.querySelector("input")!
  const list = dialog.querySelector<HTMLElement>("#search-results")!
  const status = dialog.querySelector<HTMLElement>("#search-status")!
  const mac = /Mac|iPhone|iPad/.test(navigator.platform)
  opener.dataset.tooltip = `Search  ${mac ? "⌘K" : "Ctrl K"}`

  // Shorthand people type versus the words posts use. Either side finds
  // the other.
  const synonyms: Record<string, string[]> = {
    uaf: ["use after free", "use-after-free"],
    rce: ["remote code execution", "code execution"],
    lpe: ["privilege escalation"],
    got: ["global offset table"],
    plt: ["procedure linkage table"],
    cff: ["control flow flattening"],
    cfg: ["control flow graph"],
    re: ["reverse engineering", "reversing"],
    rev: ["reverse engineering", "reversing"],
    binja: ["binary ninja"],
    bn: ["binary ninja"],
    xss: ["cross site scripting", "cross-site scripting"],
    vm: ["virtual machine"],
    il: ["intermediate language"],
    ssa: ["static single assignment"],
    poc: ["proof of concept"],
    ml: ["machine learning"],
    elf: ["executable and linkable"],
    pwn: ["exploit", "exploitation"],
  }

  const normalize = (text: string) =>
    text
      .normalize("NFKD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, " ")
      .trim()

  const field = (text: string | undefined, weight: number): Field => {
    const value = normalize(text ?? "")
    return { weight, text: ` ${value} `, words: [...new Set(value.split(" "))] }
  }

  const weights: Record<Kind, number> = {
    post: 1.25,
    page: 1.1,
    talk: 1,
    cve: 1,
    section: 0.9,
  }
  const order: Kind[] = ["post", "section", "cve", "talk", "page"]
  const limits: Record<Kind, number> = {
    post: 4,
    section: 6,
    cve: 5,
    talk: 2,
    page: 3,
  }
  const labels: Record<Kind, string> = {
    post: "posts",
    section: "sections",
    cve: "cves",
    talk: "talks",
    page: "pages",
  }

  // Damerau-Levenshtein with an early exit once past `max`.
  const distance = (a: string, b: string, max: number) => {
    if (Math.abs(a.length - b.length) > max) return max + 1
    const rows = Array.from({ length: a.length + 1 }, (_, i) => [i])
    for (let j = 1; j <= b.length; j++) rows[0][j] = j
    for (let i = 1; i <= a.length; i++) {
      let best = Infinity
      for (let j = 1; j <= b.length; j++) {
        const cost = a[i - 1] === b[j - 1] ? 0 : 1
        let value = Math.min(
          rows[i - 1][j] + 1,
          rows[i][j - 1] + 1,
          rows[i - 1][j - 1] + cost,
        )
        if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1])
          value = Math.min(value, rows[i - 2][j - 2] + 1)
        rows[i][j] = value
        best = Math.min(best, value)
      }
      if (best > max) return max + 1
    }
    return rows[a.length][b.length]
  }

  // How well one query word matches one field, from 1 (whole word) down
  // to a typo, 0 when it doesn't.
  const quality = (token: string, alternatives: string[], f: Field) => {
    if (f.text.includes(` ${token} `)) return 1
    for (const phrase of alternatives)
      if (f.text.includes(` ${phrase} `)) return 0.95
    if (f.words.some((word) => word.startsWith(token))) return 0.8
    if (token.length >= 3 && f.text.includes(token)) return 0.6
    if (token.length >= 4) {
      const max = token.length >= 7 ? 2 : 1
      if (f.words.some((word) => distance(token, word, max) <= max)) return 0.45
    }
    return 0
  }

  let docs: Doc[] | undefined
  let loading: Promise<void> | undefined
  const load = () =>
    (loading ??= fetch("/search.json")
      .then((response) => response.json() as Promise<Entry[]>)
      .then((entries) => {
        docs = entries.map((entry) => ({
          ...entry,
          fields: [
            field(entry.t, 10),
            field(entry.c, entry.k === "section" ? 2 : 4),
            field(entry.i, 3),
            field(entry.x, 1),
          ],
        }))
      })
      .catch(() => {
        loading = undefined
      }))

  const search = (query: string): Hit[] => {
    const tokens = normalize(query).split(" ").filter(Boolean)
    if (!docs || tokens.length === 0) return []
    const whole = normalize(query)
    const hits: Hit[] = []
    for (const doc of docs) {
      let score = 0
      let matched = true
      // A section has to match on its own words; its post's title alone
      // would pull in every section of that post.
      let own = doc.k !== "section"
      for (const token of tokens) {
        const alternatives = (synonyms[token] ?? []).map(normalize)
        let best = 0
        doc.fields.forEach((f, index) => {
          const value = f.weight * quality(token, alternatives, f)
          if (value > 0 && index !== 1) own = true
          best = Math.max(best, value)
        })
        if (best === 0) {
          matched = false
          break
        }
        score += best
      }
      if (!matched || !own) continue
      if (doc.fields[0].text.includes(` ${whole}`)) score += 6
      hits.push({ doc, score: score * weights[doc.k] })
    }
    return hits.sort((a, b) => b.score - a.score)
  }

  const escape = (text: string) =>
    text.replace(
      /[&<>"]/g,
      (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!,
    )

  // The words in a document that a query actually matched, typos and
  // synonyms resolved, so highlights and snippets show the real spelling.
  const matchedTerms = (doc: Doc, query: string) => {
    const terms = new Set<string>()
    for (const token of normalize(query)
      .split(" ")
      .filter((t) => t.length > 1)) {
      terms.add(token)
      for (const phrase of synonyms[token] ?? []) terms.add(normalize(phrase))
      if (token.length < 4) continue
      const max = token.length >= 7 ? 2 : 1
      for (const f of doc.fields)
        for (const word of f.words)
          if (!word.startsWith(token) && distance(token, word, max) <= max)
            terms.add(word)
    }
    return [...terms]
  }

  // Mark where the matched words appear, case insensitive.
  // Terms are normalized ("use after free"); text may say "use-after-free".
  const termPattern = (tokens: string[]) =>
    new RegExp(
      `(${[...tokens]
        .sort((a, b) => b.length - a.length)
        .map((t) =>
          t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&").replace(/ /g, "[\\s-]+"),
        )
        .join("|")})`,
      "gi",
    )

  const highlight = (text: string, tokens: string[]) =>
    tokens.length
      ? escape(text).replace(termPattern(tokens), "<mark>$1</mark>")
      : escape(text)

  // A short window of body text around the first matching word.
  const snippet = (doc: Doc, tokens: string[]) => {
    if (!doc.x) return doc.c
    const at = tokens.length ? doc.x.search(termPattern(tokens)) : -1
    if (at < 0) return doc.c
    // Start on a word, about forty characters before the match.
    const from = Math.max(0, at - 40)
    const start = from === 0 ? 0 : doc.x.indexOf(" ", from) + 1 || from
    return `${start > 0 ? "…" : ""}${doc.x.slice(start, at + 90).trim()}…`
  }

  let active = 0
  let options: HTMLAnchorElement[] = []

  const setActive = (index: number) => {
    if (!options.length) {
      input.removeAttribute("aria-activedescendant")
      return
    }
    active = (index + options.length) % options.length
    options.forEach((option, i) =>
      option.setAttribute("aria-selected", String(i === active)),
    )
    input.setAttribute("aria-activedescendant", options[active].id)
    options[active].scrollIntoView({ block: "nearest" })
  }

  const row = (doc: Doc, query: string, index: number) => {
    const terms = query ? matchedTerms(doc, query) : []
    const sub = doc.k === "section" && query ? snippet(doc, terms) : doc.c
    return `<a class="search-option" role="option" id="search-option-${index}" href="${escape(doc.u)}" data-kind="${doc.k}">
      <span class="search-title">${highlight(doc.t, terms)}</span>
      ${sub ? `<span class="search-context">${highlight(sub, terms)}</span>` : ""}
      ${doc.m ? `<span class="search-meta">${escape(doc.m)}</span>` : ""}
    </a>`
  }

  const render = () => {
    const query = input.value.trim()
    let groups: [Kind, Doc[]][]
    if (!query) {
      // Before typing: the newest posts and where else to go.
      groups = [
        ["post", (docs ?? []).filter((d) => d.k === "post").slice(0, 4)],
        ["page", (docs ?? []).filter((d) => d.k === "page").slice(0, 6)],
      ]
    } else {
      const hits = search(query)
      groups = order.map((kind) => [
        kind,
        hits
          .filter((h) => h.doc.k === kind)
          .slice(0, limits[kind])
          .map((h) => h.doc),
      ])
    }
    groups = groups.filter(([, docs]) => docs.length)
    let index = 0
    list.innerHTML = groups.length
      ? groups
          .map(
            ([kind, docs]) =>
              `<div class="search-group" role="group" aria-label="${labels[kind]}"><p class="search-label" aria-hidden="true">${query ? labels[kind] : kind === "post" ? "latest" : "pages"}</p>${docs.map((doc) => row(doc, query, index++)).join("")}</div>`,
          )
          .join("")
      : `<p class="search-empty">${docs ? `Nothing for “${escape(query)}”. Fewer or shorter words help.` : "Loading…"}</p>`
    options = [...list.querySelectorAll<HTMLAnchorElement>(".search-option")]
    status.textContent = query ? `${options.length} results` : ""
    setActive(0)
  }

  const back = closeOnBack(dialog)

  const open = () => {
    if (dialog.open) return
    dialog.showModal()
    back.opened()
    document.documentElement.style.overflow = "hidden"
    input.select()
    render()
    void load()?.then(render)
  }

  dialog.addEventListener("close", () => {
    document.documentElement.style.overflow = ""
  })

  opener.addEventListener("click", open)
  input.addEventListener("input", render)
  input.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown") setActive(active + 1)
    else if (event.key === "ArrowUp") setActive(active - 1)
    else if (event.key === "Enter" && options[active]) {
      const href = options[active].href
      back.forget()
      if (event.metaKey || event.ctrlKey)
        window.open(href, "_blank", "noopener")
      else location.assign(href)
    } else return
    event.preventDefault()
  })

  list.addEventListener("pointermove", (event) => {
    const option = (event.target as Element).closest<HTMLAnchorElement>(
      ".search-option",
    )
    if (option && options.indexOf(option) !== active)
      setActive(options.indexOf(option))
  })
  list.addEventListener("click", (event) => {
    if ((event.target as Element).closest(".search-option")) back.forget()
  })
  // Clicking the backdrop closes.
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close()
  })

  document.addEventListener("keydown", (event) => {
    const typing =
      event.target instanceof HTMLElement &&
      (event.target.isContentEditable ||
        /^(INPUT|TEXTAREA|SELECT)$/.test(event.target.tagName))
    if (
      (event.key === "k" || event.key === "K") &&
      (event.metaKey || event.ctrlKey)
    ) {
      event.preventDefault()
      if (dialog.open) dialog.close()
      else open()
    } else if (event.key === "/" && !typing && !dialog.open) {
      event.preventDefault()
      open()
    }
  })
  // Warm the index when someone looks like they're about to search.
  opener.addEventListener("pointerenter", () => void load(), { once: true })
</script>

<style is:global>
  #search {
    position: fixed;
    inset: 12vh 0 auto;
    margin-inline: auto;
    inline-size: min(40rem, calc(100vw - 1.5rem));
    max-block-size: min(76vh, 40rem);
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--background);
    color: var(--foreground);
    box-shadow: var(--shadow-lg);

    /* Opened often: it appears at once and only fades on the way out. */
    opacity: 0;
    transition:
      opacity 100ms ease,
      display 100ms allow-discrete,
      overlay 100ms allow-discrete;

    &[open] {
      display: flex;
      flex-direction: column;
      opacity: 1;
      transition: none;
    }

    &::backdrop {
      background: light-dark(rgb(30 25 15 / 0.18), rgb(0 0 0 / 0.5));
    }

    @media (width < 40rem) {
      inset-block-start: 0.75rem;
      max-block-size: calc(100dvh - 1.5rem);
    }
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding-inline: var(--space-s);
    border-block-end: 1px solid var(--border);

    > svg {
      flex: none;
      inline-size: 1.1rem;
      block-size: 1.1rem;
      color: var(--muted-foreground);
    }

    input {
      flex: 1;
      min-inline-size: 0;
      block-size: 3.25rem;
      border: 0;
      outline: 0;
      /* 16px minimum so iOS doesn't zoom into the field. */
      font-size: max(16px, var(--step-0));

      &::placeholder {
        color: var(--muted-foreground);
      }

      &::-webkit-search-cancel-button {
        display: none;
      }
    }
  }

  #search kbd {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--muted-foreground);
    font: var(--text-caption) / 1.4 var(--font-mono);
  }

  #search-results {
    flex: 1;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-3xs) var(--space-2xs) var(--space-2xs);
  }

  .search-label {
    padding: var(--space-xs) var(--space-xs) var(--space-3xs);
    color: var(--muted-foreground);
    font: var(--text-caption) / 1.4 var(--font-mono);
  }

  .search-option {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-s);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-md);
    color: var(--foreground);
    text-decoration: none;
    scroll-margin-block: var(--space-xs);

    &[aria-selected="true"] {
      background: var(--row-hover);
      box-shadow: inset 2px 0 0 var(--accent);
    }

    mark {
      background: none;
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.18em;
    }
  }

  .search-title {
    grid-column: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: var(--font-weight-medium);
  }

  .search-context {
    grid-column: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .search-meta {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    color: var(--muted-foreground);
    font: var(--text-meta) / 1.4 var(--font-mono);
    font-variant-numeric: tabular-nums;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .search-option[data-kind="cve"] .search-meta {
    text-transform: capitalize;
  }

  /* On a phone the title needs the width more than the date does. */
  @media (width < 30rem) {
    .search-option:not([data-kind="cve"]) .search-meta {
      display: none;
    }
  }

  .search-empty {
    padding: var(--space-m) var(--space-s);
    color: var(--muted-foreground);
    font-size: var(--step--1);
    text-align: center;
  }

  .search-help {
    display: flex;
    gap: var(--space-s);
    padding: var(--space-2xs) var(--space-s);
    border-block-start: 1px solid var(--border);
    color: var(--muted-foreground);
    font: var(--text-caption) / 1.4 var(--font-mono);

    kbd {
      margin-inline-end: 0.2rem;
    }
  }

  /* Keyboard hints mean nothing on a phone. */
  @media (pointer: coarse) {
    .search-help,
    .search-esc {
      display: none;
    }
  }
</style>
