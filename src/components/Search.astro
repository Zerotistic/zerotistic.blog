<button
  type="button"
  id="search-open"
  data-icon-button
  data-tooltip
  aria-label="Search"
  aria-haspopup="dialog"
>
  <svg
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="7" cy="7" r="4.5" />
    <path d="m10.5 10.5 3 3" />
  </svg>
</button>

<dialog id="search" aria-label="Search the site">
  <div class="search-field">
    <svg
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="7" cy="7" r="4.5" />
      <path d="m10.5 10.5 3 3" />
    </svg>
    <input
      type="search"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
      aria-label="Search posts, sections, CVEs, talks and mentions"
      placeholder="search posts, sections, cves…"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
    >
    <kbd class="search-esc">esc</kbd>
  </div>
  <div id="search-results" role="listbox" aria-label="Results"></div>
  <p class="search-help" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
    <span><kbd>enter</kbd> open</span>
    <span>typos are fine</span>
  </p>
  <p class="visually-hidden" role="status" id="search-status"></p>
</dialog>

<style is:global>
  #search {
    position: fixed;
    inset: 12vh 0 auto;
    margin-inline: auto;
    inline-size: min(40rem, calc(100vw - 1.5rem));
    max-block-size: min(76vh, 40rem);
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--background);
    color: var(--foreground);
    box-shadow: var(--shadow-lg);

    /* Opened often: it appears at once and only fades on the way out. */
    opacity: 0;
    transition:
      opacity 100ms ease,
      display 100ms allow-discrete,
      overlay 100ms allow-discrete;

    &[open] {
      display: flex;
      flex-direction: column;
      opacity: 1;
      transition: none;
    }

    &::backdrop {
      background: light-dark(rgb(30 25 15 / 0.18), rgb(0 0 0 / 0.5));
    }

    @media (width < 40rem) {
      inset-block-start: calc(0.75rem + env(safe-area-inset-top, 0px));
      max-block-size: calc(100dvh - 1.5rem - env(safe-area-inset-top, 0px));
    }
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding-inline: var(--space-s);
    border-block-end: 1px solid var(--border);

    > svg {
      flex: none;
      inline-size: 1.1rem;
      block-size: 1.1rem;
      color: var(--muted-foreground);
    }

    input {
      flex: 1;
      min-inline-size: 0;
      block-size: 3.25rem;
      border: 0;
      outline: 0;
      /* 16px minimum so iOS doesn't zoom into the field. */
      font-size: max(16px, var(--step-0));

      &::placeholder {
        color: var(--muted-foreground);
      }

      &::-webkit-search-cancel-button {
        display: none;
      }
    }
  }

  #search kbd {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--muted-foreground);
    font: var(--text-caption) / 1.4 var(--font-mono);
  }

  #search-results {
    flex: 1;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-3xs) var(--space-2xs) var(--space-2xs);
  }

  .search-label {
    padding: var(--space-xs) var(--space-xs) var(--space-3xs);
    color: var(--muted-foreground);
    font: var(--text-caption) / 1.4 var(--font-mono);
  }

  .search-option {
    border-radius: var(--radius-md);
    scroll-margin-block: var(--space-xs);

    &[aria-selected="true"] {
      background: var(--row-hover);
      box-shadow: inset 2px 0 0 var(--accent);
    }

    mark {
      background: none;
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.18em;
    }
  }

  .search-option-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-s);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: inherit;
    color: var(--foreground);
    text-decoration: none;
  }

  .search-title {
    grid-column: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: var(--font-weight-medium);
  }

  .search-context {
    grid-column: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  .search-meta {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
    color: var(--muted-foreground);
    font: var(--text-meta) / 1.4 var(--font-mono);
    font-variant-numeric: tabular-nums;
    text-transform: lowercase;
    white-space: nowrap;
  }

  .search-option[data-kind="cve"] .search-meta {
    text-transform: capitalize;
  }

  /* On a phone the title needs the width more than the date does. */
  @media (width < 30rem) {
    .search-option:not([data-kind="cve"]) .search-meta {
      display: none;
    }
  }

  .search-empty {
    padding: var(--space-m) var(--space-s);
    color: var(--muted-foreground);
    font-size: var(--step--1);
    text-align: center;
  }

  .search-help {
    display: flex;
    gap: var(--space-s);
    padding: var(--space-2xs) var(--space-s);
    border-block-start: 1px solid var(--border);
    color: var(--muted-foreground);
    font: var(--text-caption) / 1.4 var(--font-mono);

    kbd {
      margin-inline-end: 0.2rem;
    }
  }

  /* Keyboard hints mean nothing on a phone. */
  @media (pointer: coarse) {
    .search-help,
    .search-esc {
      display: none;
    }
  }
</style>
