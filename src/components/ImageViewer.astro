<dialog class="image-viewer" aria-label="Enlarged image">
  <button type="button" class="image-viewer-close" aria-label="Close enlarged image" autofocus>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 4 8 8m0-8-8 8" /></svg>
  </button>
  <img alt="" />
</dialog>

<style is:global>
  .image-enlarge {
    display: block;
    max-width: 100%;
    padding: 0;
    margin-inline: auto;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .image-enlarge:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  prose-content .image-enlarge img {
    display: block;
  }

  .image-viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 64px 20px 24px;
    border: 0;
    background: rgb(10 11 14 / 0.95);
    color: white;
    overflow: auto;
    cursor: zoom-out;
  }

  .image-viewer[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-viewer::backdrop {
    background: rgb(0 0 0 / 0.7);
  }

  .image-viewer img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  ::view-transition-group(enlarged-image) {
    animation-duration: 320ms;
    animation-timing-function: var(--ease-out);
  }

  .image-viewer-close {
    position: fixed;
    top: 12px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid #646770;
    border-radius: 50%;
    background: #24262c;
    color: white;
    cursor: pointer;
    transition: scale var(--dur-press) var(--ease-out);

    svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
    }

    &:active {
      scale: 0.92;
    }
  }
</style>
