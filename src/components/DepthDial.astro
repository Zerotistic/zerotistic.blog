<!-- Written like the site's nav: three words, the current one underlined.
     The label carries the reading time of whichever level you point at. -->
<depth-dial hidden>
  <p class="depth-label">
    <span id="depth-label">Depth</span>
    <span class="depth-time" aria-hidden="true"></span>
  </p>
  <div class="depth-options" role="radiogroup" aria-labelledby="depth-label">
    <button type="button" role="radio" aria-checked="false" data-level="skim">
      skim
    </button>
    <button type="button" role="radio" aria-checked="false" data-level="idea">
      the idea
    </button>
    <button type="button" role="radio" aria-checked="true" data-level="full">
      every byte
    </button>
  </div>
</depth-dial>

<style is:global>
  depth-dial {
    display: block;
    margin-block-end: var(--space-m);

    &[hidden] {
      display: none;
    }

    @media (width < 64rem) {
      margin-block: var(--space-xs) var(--space-s);
    }
  }

  .depth-label {
    display: flex;
    justify-content: space-between;
    margin-block-end: var(--space-3xs);
    color: var(--muted-foreground);
    font: 0.75rem / 1.5 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .depth-time {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    text-transform: none;
  }

  /* Same voice as the sidebar nav: mono, muted, current one in foreground
     with the accent underline. */
  .depth-options {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-s);
    margin-inline: -0.25rem;

    button {
      padding: 0.3rem 0.25rem;
      color: var(--muted-foreground);
      font: var(--step--1) / 1.5 var(--font-mono);
      text-decoration: underline;
      text-decoration-color: transparent;
      text-decoration-thickness: max(1px, 0.0625em);
      text-underline-offset: 0.3em;
      white-space: nowrap;
      cursor: pointer;
      transition:
        color var(--dur-hover) ease,
        text-decoration-color var(--dur-hover) ease;

      &[aria-checked="true"] {
        color: var(--foreground);
        text-decoration-color: var(--accent);
      }

      @media (hover: hover) {
        &:hover {
          color: var(--foreground);
        }
      }

      @media (width < 64rem) {
        min-block-size: 2.75rem;
      }
    }
  }

  /* What a level would fold, while you point at it. */
  prose-content [data-depth-preview] {
    opacity: 0.25;
    transition: opacity var(--dur-hover) ease;
  }

  page-toc a:is([data-folded], [data-depth-preview]) {
    opacity: 0.45;
  }

  .depth-stub {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
    inline-size: 100%;
    margin-block: 0 1em;
    padding: 0.35rem 0.75rem;
    border-inline-start: 2px solid var(--border);
    color: var(--muted-foreground);
    font-size: var(--step--1);
    line-height: 1.5;
    text-align: start;
    cursor: pointer;

    .stub-plus {
      flex: none;
      color: var(--accent);
      font-family: var(--font-mono);
    }

    .stub-meta {
      flex: none;
      font: var(--text-meta) / 1.5 var(--font-mono);
    }

    .stub-teaser {
      flex: 1;
      min-inline-size: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      opacity: 0.8;
    }

    &[data-code] .stub-teaser {
      font: var(--text-meta) / 1.5 var(--font-mono);
    }

    @media (hover: hover) {
      &:hover {
        color: var(--foreground);
        border-inline-start-color: var(--accent);
      }
    }
  }
</style>
