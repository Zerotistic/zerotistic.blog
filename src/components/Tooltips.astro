<style is:global>
  .tooltip {
    position: fixed;
    z-index: 200;
    max-inline-size: 20rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--foreground);
    color: var(--background);
    font: var(--text-meta) / 1.4 var(--font-mono);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    scale: 0.96;
    transition:
      opacity 100ms ease,
      scale 100ms ease;

    &[data-visible] {
      opacity: 1;
      scale: 1;
      transition:
        opacity var(--dur-hover) var(--ease-out),
        scale var(--dur-hover) var(--ease-out);
    }
  }
</style>
