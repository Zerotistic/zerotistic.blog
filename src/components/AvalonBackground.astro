<div class="avalon-scene" aria-hidden="true">
  <div class="avalon-landscape avalon-day"></div>
  <div class="avalon-landscape avalon-night"></div>
  <canvas class="avalon-life" data-side="left"></canvas>
  <canvas class="avalon-life" data-side="right"></canvas>
</div>

<style is:global>
  .avalon-scene {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    contain: strict;
  }

  .avalon-landscape {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center bottom;
    mask-image: linear-gradient(
      to right,
      #000,
      #000 calc(50% - 38rem),
      transparent calc(50% - 25rem),
      transparent calc(50% + 25rem),
      #000 calc(50% + 38rem),
      #000
    );
    transition: opacity 1.2s ease;
  }

  .avalon-day {
    background-image: var(--avalon-day-image, none);
    opacity: 0.38;
  }

  .avalon-night {
    background-image:
      linear-gradient(
        to bottom,
        #111110 0%,
        rgb(17 17 16 / 0.85) 30%,
        transparent 65%
      ),
      var(--avalon-night-image, none);
    opacity: 0;
  }

  :root[data-theme="dark"] {
    .avalon-day {
      opacity: 0;
    }
    .avalon-night {
      opacity: 0.65;
    }
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      .avalon-day {
        opacity: 0;
      }
      .avalon-night {
        opacity: 0.65;
      }
    }
  }

  /* Each canvas only covers the margin it draws in. */
  .avalon-life {
    position: absolute;
    inset-block: 0;
    inline-size: var(--avalon-strip, 0px);
    block-size: 100%;

    &[data-side="left"] {
      left: 0;
    }

    &[data-side="right"] {
      right: 0;
    }

    @media (width < 64rem) {
      display: none;
    }
  }

  @media (width < 80rem) {
    .avalon-landscape {
      inset-block-start: auto;
      block-size: 12rem;
      mask-image: linear-gradient(to bottom, transparent, rgb(0 0 0 / 0.22));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .avalon-life {
      display: none;
    }
    .avalon-landscape {
      transition: none;
    }
  }
</style>

<script>
  import { initAvalon } from "@/lib/avalon-scene"
  const scene = document.querySelector<HTMLElement>(".avalon-scene")
  const [left, right] = document.querySelectorAll<HTMLCanvasElement>(".avalon-life")
  if (scene && left && right) initAvalon(scene, left, right)
</script>
