---
import ChevronIcon from "@/assets/icons/callouts/alt-arrow-down.svg"
import DepthDial from "@/components/DepthDial.astro"
import { titleHtml } from "@/lib/content"
import type { MarkdownHeading } from "astro"

type Section = {
  id?: string
  label: string
  open?: boolean
  headings: MarkdownHeading[]
}
type Props = { title: string; sections: Section[] }

const { title, sections } = Astro.props
---

<nav aria-label="Table of contents">
  <button
    class="toc-toggle"
    type="button"
    data-bar
    aria-expanded="false"
    aria-controls="toc-panel"
  >
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="8" cy="8" r="6.5" />
      <circle cx="8" cy="8" r="6.5" transform="rotate(-90 8 8)" />
    </svg>
    <span class="visually-hidden">Contents, current section: </span>
    <toc-current set:html={titleHtml(title)} />
    <span class="toc-depth" hidden></span>
    <ChevronIcon aria-hidden="true" />
  </button>
  <!-- The sticky column on desktop, the dropdown under the bar on phones. -->
  <div class="toc-panel" id="toc-panel" data-bar>
    <DepthDial />
    <p class="toc-kicker">On this page</p>
    <ul class="toc-list">
    <li class="toc-indicator" aria-hidden="true"></li>
    <li data-depth="2"><a href="#introduction">Introduction</a></li>
    {sections.map(({ id, label, open, headings }) =>
        id ? (
          <li data-group>
            {headings.length > 0 ? (
              <details open={open || undefined}>
                <summary>
                  <a href={`#${id}`} set:html={titleHtml(label)} />
                  <ChevronIcon aria-hidden="true" />
                </summary>
                <ul>
                  {headings.map(({ depth, slug, text }) => (
                    <li data-depth={depth}>
                      <a href={`#${slug}`}>{text}</a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a href={`#${id}`} set:html={titleHtml(label)} />
            )}
          </li>
        ) : (
          headings.map(({ depth, slug, text }) => (
            <li data-depth={depth}>
              <a href={`#${slug}`}>{text}</a>
            </li>
          ))
        ),
      )}
    </ul>
  </div>
</nav>

<style>
  .toc-kicker {
    margin-block: 0 var(--space-s);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--muted-foreground);

    @media (width < 64rem) {
      display: none;
    }
  }

  nav {
    position: sticky;
    top: var(--page-offset-top);
    display: flex;
    flex-direction: column;
    max-height: calc(
      100svh -
      var(--page-offset-top) -
      var(--page-offset-bottom)
    );
    font-size: var(--step--1);

    @media (width < 64rem) {
      position: relative;
      top: auto;
      max-height: none;
    }
  }

  .toc-toggle {
    display: none;

    @media (width < 64rem) {
      display: flex;
      inline-size: 100%;
      min-block-size: 2.75rem;
      align-items: center;
      gap: var(--space-2xs);
      cursor: pointer;
      text-align: start;

      &:focus-visible {
        outline-offset: -2px;
      }

      > svg:first-of-type {
        flex-shrink: 0;
        inline-size: 1em;
        block-size: 1em;

        circle {
          fill: none;
          stroke: var(--border);
          stroke-width: 2;

          &:last-child {
            --circumference: calc(2 * pi * 6.5px);

            stroke: var(--muted-foreground);
            stroke-dasharray: var(--circumference);
            stroke-dashoffset: calc(
              var(--circumference) *
              (1 - var(--progress, 0))
            );

            /* Reading progress straight from the page scroll, no listener. */
            @supports (animation-timeline: scroll()) {
              animation: toc-progress linear both;
              animation-timeline: scroll(root);
            }
          }
        }
      }

      toc-current {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--muted-foreground);
      }

      /* Says the post is folded, so a short page isn't a surprise. */
      .toc-depth:not([hidden]) {
        flex: none;
        color: var(--accent);
        font: var(--text-meta) / 1.4 var(--font-mono);
      }

      > svg:last-of-type {
        flex-shrink: 0;
        inline-size: 1em;
        block-size: 1em;
        color: var(--muted-foreground);
      }
    }
  }

  @keyframes toc-progress {
    from {
      stroke-dashoffset: var(--circumference);
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .toc-toggle[aria-expanded="true"] > svg:last-of-type {
    @media (width < 64rem) {
      rotate: 180deg;
    }
  }

  /* One marker that slides to the current section, so it reads as the
     same thing moving instead of bars blinking in and out. */
  .toc-indicator {
    display: none;

    @media (width >= 64rem) {
      display: block;
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 0;
      inline-size: 2px;
      block-size: var(--indicator-size, 0px);
      border-radius: var(--radius-full);
      background: var(--accent);
      opacity: 0;
      translate: 0 var(--indicator-offset, 0px);
      pointer-events: none;

      &[data-placed] {
        opacity: 1;
      }

      &[data-moving] {
        transition:
          translate var(--dur-state) var(--ease-out),
          block-size var(--dur-state) var(--ease-out);
      }
    }
  }

  .toc-panel {
    /* On desktop its children sit straight in the sticky column. */
    display: contents;

    @media (width < 64rem) {
      display: none;
      position: absolute;
      inset-block-start: 100%;
      inset-inline: 0;
      flex-direction: column;
      max-block-size: 70svh;
      /* A dropdown over text needs to be opaque, the blurred bar isn't. */
      background-color: var(--background);
      box-shadow: var(--shadow-lg);
    }
  }

  nav:has(.toc-toggle[aria-expanded="true"]) .toc-panel {
    @media (width < 64rem) {
      display: flex;
    }
  }

  .toc-list {
    position: relative;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;

    @media (width >= 64rem) {
      border-inline-start: 1px solid var(--border);
      padding-block: 2px;
    }

    @media (width < 64rem) {
      padding-block-end: var(--space-2xs);
    }

    &::-webkit-scrollbar {
      display: none;
    }
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;

    a {
      color: var(--muted-foreground);
      display: block;
      padding-block: 0.3rem;
      line-height: 1.45;
      text-decoration: none;

      @media (width >= 64rem) {
        padding-inline: 16px 6px;
      }

      /* Color only: a weight change widens the line and can rewrap it. */
      &[data-active] {
        color: var(--foreground);
      }

      @media (hover: hover) {
        &:hover {
          color: var(--foreground);
        }
      }
    }

    li[data-group] {
      font-weight: var(--font-weight-medium);

      &:not(:first-child) {
        margin-block-start: var(--space-2xs);
      }

      summary {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        cursor: pointer;
        list-style: none;

        &::-webkit-details-marker {
          display: none;
        }

        a {
          min-inline-size: 0;
        }

        svg {
          flex-shrink: 0;
          margin-inline-start: auto;
          inline-size: 1em;
          block-size: 1em;
          color: var(--muted-foreground);
          transition: rotate var(--dur-state) var(--ease-out);
        }

        @media (hover: hover) {
          &:hover svg {
            color: var(--foreground);
          }
        }
      }

      details[open] > summary svg {
        rotate: 180deg;
      }

      details > ul {
        --shift: 1;

        margin-block-start: var(--space-3xs);
        font-weight: var(--font-weight-normal);
      }

      details:not([open]):has(a[data-active]) summary a {
        color: var(--foreground);
      }
    }

    li[data-depth] {
      padding-inline-start: calc(
        (var(--shift, 0) + var(--indent, 0)) *
        var(--space-xs)
      );
    }

    li[data-depth="3"] {
      --indent: 1;
    }

    li[data-depth="4"] {
      --indent: 2;
    }
  }
</style>

<script>
  import { hashId } from "@/lib/utils"

  ;(() => {
    const nav = document.querySelector<HTMLElement>("page-toc nav")
    if (!nav) return

    const ring = nav.querySelector<SVGElement>(".toc-toggle svg")
    const mobile = matchMedia("(width < 64rem)")
    // Browsers with scroll-driven animations draw the ring in CSS.
    if (!CSS.supports("animation-timeline: scroll()")) {
      const progress = () => {
        if (!ring || !mobile.matches) return
        const max = document.documentElement.scrollHeight - innerHeight
        ring.style.setProperty(
          "--progress",
          String(max > 0 ? Math.min(scrollY / max, 1) : 0),
        )
      }
      addEventListener("scroll", progress, { passive: true })
      mobile.addEventListener("change", progress)
      progress()
    }

    const links = new Map(
      [...nav.querySelectorAll<HTMLAnchorElement>("a[href^='#']")].map((a) => [
        hashId(a.hash),
        a,
      ]),
    )
    const articles = document.querySelectorAll("main article")
    const list = nav.querySelector<HTMLElement>(".toc-list")
    const panel = nav.querySelector<HTMLElement>(".toc-panel")
    const currentLabel = nav.querySelector("toc-current")
    const toggle = nav.querySelector<HTMLButtonElement>(".toc-toggle")
    const indicator = nav.querySelector<HTMLElement>(".toc-indicator")
    if (articles.length === 0 || !list || links.size === 0) return

    const isOpen = () => toggle?.getAttribute("aria-expanded") === "true"
    const setOpen = (open: boolean) =>
      toggle?.setAttribute("aria-expanded", String(open))

    // Measured against the list so it scrolls along with it. The first
    // placement jumps; after that it slides.
    const placeIndicator = (link?: HTMLAnchorElement) => {
      if (!indicator || mobile.matches) return
      if (!link || !link.checkVisibility()) {
        indicator.removeAttribute("data-placed")
        return
      }
      const listTop = list.getBoundingClientRect().top - list.scrollTop
      const box = link.getBoundingClientRect()
      const inset = parseFloat(getComputedStyle(link).paddingBlockStart) * 0.5
      indicator.style.setProperty("--indicator-offset", `${box.top - listTop + inset}px`)
      indicator.style.setProperty("--indicator-size", `${box.height - 2 * inset}px`)
      if (indicator.hasAttribute("data-placed")) indicator.setAttribute("data-moving", "")
      else requestAnimationFrame(() => indicator.setAttribute("data-moving", ""))
      indicator.setAttribute("data-placed", "")
    }

    const fallback = currentLabel?.textContent ?? ""

    const groups = [
      ...nav.querySelectorAll<HTMLDetailsElement>("li[data-group] details"),
    ].map((details) => ({
      details,
      active: details.open,
      ids: [...details.querySelectorAll<HTMLAnchorElement>("a[href^='#']")].map(
        (a) => hashId(a.hash),
      ),
    }))

    const blockOf = new Map<Element, string>()
    for (const id of links.keys()) {
      const block = document
        .getElementById(id)
        ?.closest("prose-content > *, article[data-url]")
      if (block && !blockOf.has(block)) blockOf.set(block, id)
    }

    const sectionOf = new Map<Element, string>()
    for (const article of articles) {
      let current = blockOf.get(article)
      for (const child of article.children) {
        if (child.tagName === "PROSE-CONTENT") {
          for (const block of child.children) {
            current = blockOf.get(block) ?? current
            if (current) sectionOf.set(block, current)
          }
        } else if (current) sectionOf.set(child, current)
      }
    }

    const visible = new Set<Element>()
    let prevActive = new Set<string>()

    const center = () => {
      const run = [
        ...list.querySelectorAll<HTMLAnchorElement>("a[data-active]"),
      ]
      const first = run[0]
      const last = run[run.length - 1]
      if (!first || !run.every((a) => a.checkVisibility())) return
      const area = list.getBoundingClientRect()
      const runCenter =
        (first.getBoundingClientRect().top +
          last.getBoundingClientRect().bottom) /
        2
      list.scrollTo({
        top: list.scrollTop + runCenter - (area.top + area.height / 2),
      })
    }

    toggle?.addEventListener("click", () => {
      setOpen(!isOpen())
      if (isOpen()) center()
    })

    document.addEventListener("pointerdown", (event) => {
      if (mobile.matches && isOpen() && !event.composedPath().includes(nav)) {
        setOpen(false)
      }
    })
    document.addEventListener("keydown", (event) => {
      if (
        event.key !== "Escape" ||
        event.defaultPrevented ||
        !mobile.matches ||
        !isOpen()
      )
        return
      event.preventDefault()
      setOpen(false)
      toggle?.focus({ preventScroll: true })
    })
    mobile.addEventListener("change", () => {
      if (!mobile.matches) setOpen(false)
      placeIndicator(list.querySelector<HTMLAnchorElement>("a[aria-current]") ?? undefined)
    })

    // Picking a section or a depth closes the dropdown so you see it apply.
    panel?.addEventListener("click", (event) => {
      if ((event.target as Element).closest?.("a, [data-level]")) setOpen(false)
    })

    // Opening or closing a group moves the links below it.
    list.addEventListener("toggle", () =>
      placeIndicator(list.querySelector<HTMLAnchorElement>("a[aria-current]") ?? undefined),
    true)

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target)
        else visible.delete(entry.target)
      }

      const activeIds = new Set<string>()
      for (const block of visible) {
        const id = sectionOf.get(block)
        if (id) activeIds.add(id)
      }

      let firstActive: HTMLAnchorElement | undefined
      // A sliver of the preceding section shouldn't own the current marker.
      const visibleHeight = new Map<string, number>()
      for (const block of visible) {
        const id = sectionOf.get(block)
        if (!id) continue
        const rect = block.getBoundingClientRect()
        const height = Math.max(0, Math.min(rect.bottom, innerHeight) - Math.max(rect.top, 0))
        visibleHeight.set(id, (visibleHeight.get(id) ?? 0) + height)
      }
      let largestHeight = -1
      for (const [id, link] of links) {
        const on = activeIds.has(id)
        link.toggleAttribute("data-active", on)
        link.removeAttribute("aria-current")
        if (on && (visibleHeight.get(id) ?? 0) > largestHeight) {
          largestHeight = visibleHeight.get(id) ?? 0
          firstActive = link
        }
      }
      firstActive?.setAttribute("aria-current", "location")

      if (currentLabel) {
        // Before the first heading the bar keeps showing the post title.
        const intro = firstActive?.hash === "#introduction"
        const label = (!intro && firstActive?.textContent?.trim()) || fallback
        if (currentLabel.textContent !== label) currentLabel.textContent = label
      }

      for (const group of groups) {
        const active = group.ids.some((id) => activeIds.has(id))
        if (active !== group.active) {
          group.active = active
          if (active) group.details.open = true
        }
      }

      let grew = false
      for (const id of activeIds) {
        if (!prevActive.has(id)) {
          grew = true
          break
        }
      }
      prevActive = activeIds
      if (grew) center()
      placeIndicator(firstActive)
    })

    for (const block of sectionOf.keys()) observer.observe(block)
  })()
</script>
