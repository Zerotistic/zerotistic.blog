---
import SocialIcons from "@/components/SocialIcons.astro"
import Artoria from "@/components/Artoria.astro"
import { SITE, SOCIALS } from "@/consts"

type Props = { showArtoria?: boolean; showSocials?: boolean }
const { showArtoria = true, showSocials = true } = Astro.props
---

{showArtoria && <Artoria placement="footer" />}
<footer>
  <p>
    &copy; {new Date().getFullYear()} {SITE.title} · <a href="/rss.xml">rss</a>
  </p>
  {showSocials && <SocialIcons links={SOCIALS} />}
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-block: var(--space-xs) var(--page-offset-bottom);

    @media (width >= 40rem) {
      flex-direction: row;
      justify-content: space-between;
    }

    p {
      font-family: var(--font-mono);
      font-size: var(--text-meta);
      letter-spacing: 0;
      color: var(--muted-foreground);
    }

    /* Inline padding grows the target without moving the text. */
    p a {
      padding: 0.75rem 0.375rem;
      margin-inline: -0.375rem;
    }
  }
</style>
