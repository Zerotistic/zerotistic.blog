---
import MoonIcon from "@/assets/icons/moon.svg"
import SunIcon from "@/assets/icons/sun.svg"
---

<button id="theme-toggle" data-icon-button data-tooltip aria-label="Switch theme">
  <light-icon><SunIcon /></light-icon>
  <dark-icon><MoonIcon /></dark-icon>
</button>

<style is:global>
  :root[data-theme="light"] {
    color-scheme: light;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
  }

  #theme-toggle {
    display: inline-grid;

    /* Both icons share one cell and cross fade, so the swap reads as one
       icon changing instead of a hard cut. */
    > * {
      grid-area: 1 / 1;
      display: grid;
      place-items: center;
      transition:
        opacity var(--dur-state) var(--ease-out),
        scale var(--dur-state) var(--ease-out),
        filter var(--dur-state) var(--ease-out);
    }
  }

  dark-icon,
  :root[data-theme="dark"] light-icon {
    opacity: 0;
    scale: 0.25;
    filter: blur(4px);
  }

  :root[data-theme="dark"] dark-icon {
    opacity: 1;
    scale: 1;
    filter: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      light-icon {
        opacity: 0;
        scale: 0.25;
        filter: blur(4px);
      }

      dark-icon {
        opacity: 1;
        scale: 1;
        filter: none;
      }
    }
  }
</style>
