---
import PostRow from "@/components/PostRow.astro"
import { getPosts, getSubposts } from "@/lib/content"

const posts = await getPosts()
const series = await getSubposts()
const entries = posts.map((post) => ({
  post,
  partCount: (series.get(post.id) ?? []).length,
  tags: [],
}))
const years = Map.groupBy(entries, ({ post }) =>
  post.data.date.getUTCFullYear().toString(),
)
---

<archive-groups>
  {[...years].map(([year, yearEntries]) => (
    <section aria-labelledby={`year-${year}`}>
      <h2 class="section-title" id={`year-${year}`}>{year}</h2>
      <ol>
        {yearEntries.map((entry) => <PostRow {...entry} showYear={false} />)}
      </ol>
    </section>
  ))}
</archive-groups>

<style>
  archive-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);

    @media (width < 34rem) {
      gap: var(--space-l);
    }
  }

  section {
    display: block;

    h2 {
      margin-block-end: var(--space-xs);
      font-variant-numeric: tabular-nums;
      color: var(--foreground);
    }
  }

  ol {
    display: block;
    list-style: none;
  }
</style>
