---
import PostRow from "@/components/PostRow.astro"
import { getPosts, getSubposts } from "@/lib/content"

const posts = await getPosts()
const series = await getSubposts()
const entries = posts.map((post) => ({
  post,
  partCount: (series.get(post.id) ?? []).length,
  tags: [],
}))
const years = Map.groupBy(entries, ({ post }) =>
  post.data.date.getUTCFullYear().toString(),
)
---

<archive-groups>
  {[...years].map(([year, yearEntries]) => (
    <section aria-labelledby={`year-${year}`}>
      <h2 id={`year-${year}`}>{year}</h2>
      <ol>
        {yearEntries.map((entry) => <PostRow {...entry} />)}
      </ol>
    </section>
  ))}
</archive-groups>

<style>
  archive-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  section {
    display: block;

    h2 {
      margin-block-end: var(--space-xs);
      font-family: var(--font-mono);
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0;
      color: var(--foreground);
    }
  }

  ol {
    display: block;
    list-style: none;
  }
</style>
