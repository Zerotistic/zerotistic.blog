---
import PostRow from "@/components/PostRow.astro"
import { getPosts, getSubposts } from "@/lib/content"

type Props = {
  start?: number
  limit?: number
}

const { start = 0, limit } = Astro.props
const posts = await getPosts()
const series = await getSubposts()

const entries = posts
  .map((post) => {
    const parts = series.get(post.id) ?? []
    const tags = [
      ...new Set([post, ...parts].flatMap((entry) => entry.data.tags ?? [])),
    ]
    return { post, partCount: parts.length, tags }
  })
  .slice(start, limit === undefined ? undefined : start + limit)
---

<post-list>
  <ol>
    {entries.map((entry) => <PostRow {...entry} />)}
  </ol>
</post-list>

<style>
  post-list,
  ol {
    display: block;
  }

  ol {
    list-style: none;
  }
</style>
