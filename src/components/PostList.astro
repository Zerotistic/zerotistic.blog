---
import { getPosts, getSubposts } from "@/lib/content"
import { formatDate } from "@/lib/utils"

const posts = await getPosts()
const series = await getSubposts()

const entries = posts.map((post) => {
  const parts = series.get(post.id) ?? []
  const tags = [
    ...new Set([post, ...parts].flatMap((entry) => entry.data.tags ?? [])),
  ]
  return { post, partCount: parts.length, tags }
})
---

<post-list>
  <ol>
    {entries.map(({ post, partCount, tags }, i) => (
        <li style={`--i:${i}`}>
          <a href={`/posts/${post.id}`}>
            <row-marker aria-hidden="true">&rsaquo;</row-marker>
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <row-title>
              <span>{post.data.title}</span>
              {partCount > 0 && (
                <series-badge>series · {partCount}</series-badge>
              )}
            </row-title>
            <row-tags>
              {tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </row-tags>
          </a>
        </li>
      ))}
  </ol>
</post-list>

<style>
  post-list ol {
    display: flex;
    flex-direction: column;
    list-style: none;
  }

  post-list li {
    border-block-start: 1px solid var(--border);
    animation: row-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i) * 55ms);

    &:last-child {
      border-block-end: 1px solid var(--border);
    }
  }

  post-list a {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: var(--space-s);
    row-gap: var(--space-2xs);
    padding-block: var(--space-s);
    padding-inline-start: 0;
    text-decoration: none;
    transition: padding-inline-start 0.28s cubic-bezier(0.22, 1, 0.36, 1);

    row-marker {
      position: absolute;
      inset-inline-start: 0;
      inset-block-start: var(--space-s);
      font-family: var(--font-mono);
      line-height: calc(var(--leading-offset) + 1em);
      color: var(--accent);
      opacity: 0;
      translate: -0.4rem 0;
      transition:
        opacity 0.28s ease,
        translate 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    }

    time {
      grid-row: 1;
      grid-column: 1;
      font-family: var(--font-mono);
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
      color: var(--muted-foreground);
      white-space: nowrap;
      transition: color 0.2s ease;
    }

    row-title {
      grid-row: 1;
      grid-column: 2;
      font-size: var(--step-0);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);

      span {
        text-wrap: balance;
      }
    }

    row-tags {
      grid-row: 2;
      grid-column: 2;
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xs);
      font-family: var(--font-mono);
      font-size: var(--step--1);
      letter-spacing: 0;
      color: color-mix(in oklab, var(--muted-foreground) 55%, transparent);

      span::before {
        content: "#";
        opacity: 0.5;
      }
    }

    series-badge {
      margin-inline-start: var(--space-2xs);
      font-family: var(--font-mono);
      font-size: 0.7em;
      letter-spacing: 0;
      color: var(--muted-foreground);
      border: 1px solid var(--border);
      border-radius: var(--radius-full);
      padding-inline: var(--space-2xs);
      white-space: nowrap;
    }

    /* Hover: the marker slides in and the row shifts right to make room. */
    &:hover,
    &:focus-visible {
      padding-inline-start: 1.1rem;

      row-marker {
        opacity: 1;
        translate: 0 0;
      }

      time {
        color: var(--foreground);
      }

      row-title span {
        text-decoration: underline;
        text-decoration-color: var(--underline, var(--foreground));
        text-underline-offset: 0.2em;
      }
    }
  }

  @keyframes row-in {
    from {
      opacity: 0;
      translate: 0 0.6rem;
      filter: blur(2px);
    }
    to {
      opacity: 1;
      translate: 0 0;
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    post-list li {
      animation: none;
    }

    post-list a {
      transition: none;

      row-marker {
        transition: none;
      }
    }
  }
</style>
