---
import ThemeToggle from "@/components/ThemeToggle.astro"
import Artoria from "@/components/Artoria.astro"
import ScrollEdges from "@/components/ScrollEdges.astro"
import { NAVIGATION, SITE } from "@/consts"
import { normalizePath } from "@/lib/utils"

type Props = {
  crumbs?: { label: string; href: string }[]
  showArtoria?: boolean
}

const { crumbs = [], showArtoria = true } = Astro.props
const pathname = normalizePath(Astro.url.pathname) || "/"
const section = NAVIGATION.find(
  ({ href }) => pathname === href || pathname.startsWith(`${href}/`),
)
---

<aside data-bar>
  <sidebar-inner>
    <a href="/" aria-label={SITE.title}>
      <span>{SITE.title}</span><cursor-block aria-hidden="true"></cursor-block>
    </a>
    <nav aria-label="Main navigation">
      <ScrollEdges>
      <ul data-site-links>
        {NAVIGATION.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  pathname === item.href
                    ? "page"
                    : item === section
                      ? "location"
                      : undefined
                }
              >
                {item.label}
              </a>
              {item === section && crumbs.length > 0 && pathname !== item.href && (
                <ul>
                  {crumbs.map((crumb, i) => (
                    <li data-depth={i ? 1 : undefined}>
                      <a
                        href={crumb.href}
                        aria-current={
                          i === crumbs.length - 1 ? "page" : undefined
                        }
                      >
                        {crumb.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        {!section &&
            crumbs.map((crumb, i) => (
              <li data-depth={i ? 1 : undefined}>
                <a
                  href={crumb.href}
                  aria-current={i === crumbs.length - 1 ? "page" : undefined}
                >
                  {crumb.label}
                </a>
              </li>
            ))}
      </ul>
      </ScrollEdges>
    </nav>
    {showArtoria && <Artoria placement="sidebar" />}
  </sidebar-inner>
  <sidebar-toggle>
    <ThemeToggle />
    <slot name="actions" />
  </sidebar-toggle>
</aside>

<script>
  const mobileNavigation = matchMedia("(width < 64rem)")

  document.querySelectorAll<HTMLElement>("[data-site-links]").forEach((links) => {
    const reveal = (link: HTMLAnchorElement | null) => {
      if (!mobileNavigation.matches || !link) return
      const bounds = links.getBoundingClientRect()
      const item = link.getBoundingClientRect()
      // Scroll only the link strip, never the page or its hash destination.
      if (item.left < bounds.left) links.scrollLeft += item.left - bounds.left
      else if (item.right > bounds.right) links.scrollLeft += item.right - bounds.right
    }

    const revealCurrent = () => reveal(
      links.querySelector<HTMLAnchorElement>(":scope > li > a[aria-current]"),
    )
    links.addEventListener("focusin", (event) => {
      if (event.target instanceof Element) reveal(event.target.closest("a"))
    })

    new ResizeObserver(revealCurrent).observe(links)
    document.fonts.ready.then(revealCurrent)
    mobileNavigation.addEventListener("change", revealCurrent)
  })
</script>

<style>
  aside {
    position: sticky;
    top: var(--page-offset-top);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100svh - var(--page-offset-top) - var(--page-offset-bottom));

    @media (width < 64rem) {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      gap: var(--space-s);
    }

    @media (width < 40rem) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0 var(--space-s);
    }
  }

  sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);

    > a {
      display: inline-flex;
      align-items: center;
      gap: 0.15rem;
      width: fit-content;
      font-family: var(--font-mono);
      font-weight: var(--font-weight-medium);
      font-size: var(--step-0);
      letter-spacing: 0;
      color: var(--foreground);
      text-decoration-line: none;

      cursor-block {
        display: inline-block;
        inline-size: 0.55em;
        block-size: 1.05em;
        translate: 0 0.12em;
        background-color: var(--accent);
        animation: cursor-intro 1.2s steps(1) 2;
      }

      &:hover cursor-block {
        animation: cursor-blink 1s steps(1) infinite;
      }
    }

    @media (width < 64rem) {
      flex: 1;
      min-width: 0;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-s);

      > a {
        flex: none;
      }
    }

    @media (width < 40rem) {
      display: contents;

      > a {
        grid-column: 1;
        grid-row: 1;
        min-block-size: 2rem;
      }

      nav {
        grid-column: 1 / -1;
        grid-row: 2;
      }
    }
  }

  nav {
    @media (width < 64rem) {
      min-inline-size: 0;
      margin-inline: -0.5rem;
    }

    @media (width < 40rem) {
      margin-inline: -0.375rem;
    }
  }

  nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);

    a {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--step--1);
      letter-spacing: 0;
      color: var(--muted-foreground);

      &:hover,
      &[aria-current] {
        color: var(--foreground);
      }

      &[aria-current] {
        text-decoration-color: var(--accent);
      }
    }

    li[data-depth="1"] a {
      margin-inline-start: var(--space-xs);
    }

    ul {
      margin-block-start: var(--space-3xs);

      a {
        margin-inline-start: var(--space-xs);
      }

      li[data-depth="1"] a {
        margin-inline-start: calc(2 * var(--space-xs));
      }
    }

    @media (width < 64rem) {
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      gap: max(0px, calc(var(--space-s) - 1rem));
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-padding-inline: 2px;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }

      > li {
        flex: none;
      }

      a {
        display: flex;
        align-items: center;
        min-inline-size: 2.75rem;
        min-block-size: 2.75rem;
        padding-inline: 0.5rem;
        white-space: nowrap;

        &:focus-visible {
          outline-offset: -2px;
        }
      }

      ul {
        display: none;
      }
    }

    @media (width < 40rem) {
      gap: 0;

      a {
        padding-inline: 0.375rem;
      }
    }
  }

  nav li:has(> ul) > a {
    @media (width < 64rem) {
      color: var(--foreground);
    }
  }

  sidebar-toggle {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    margin-inline-start: -0.5rem;

    @media (width < 64rem) {
      margin-inline-start: 0;
      margin-inline-end: -0.5rem;
    }

    @media (width < 40rem) {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }
  }

  @keyframes cursor-intro {
    0%,
    40%,
    100% {
      opacity: 1;
    }
    41%,
    80% {
      opacity: 0;
    }
  }

  @keyframes cursor-blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    sidebar-inner > a cursor-block,
    sidebar-inner > a:hover cursor-block {
      animation: none;
      opacity: 1;
    }
  }
</style>
