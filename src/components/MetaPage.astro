---
import { getEntry } from "astro:content"
import DiscordEmbed from "@/components/DiscordEmbed.astro"
import { SITE, SOCIALS } from "@/consts"
import { pageTitle } from "@/lib/content"

type Props = {
  title?: string
  description?: string
  noindex?: boolean
}

const { title, description = SITE.description, noindex = false } = Astro.props

const base = Astro.site ?? new URL(Astro.url.origin)
const ogTitle = title ?? SITE.title
const fullTitle = title ? pageTitle(title) : SITE.title
const canonical = new URL(Astro.url.pathname, base)
const ogImage = new URL(SITE.defaultPageImage, base)
const isHome = Astro.url.pathname === "/" && !noindex
const isAbout = Astro.url.pathname.replace(/\/+$/, "") === "/about" && !noindex
const author = isHome ? await getEntry("authors", "zerotistic") : undefined

const personSchema = {
  "@type": "Person",
  "@id": new URL("/#person", base).href,
  name: SITE.title,
  url: new URL("/", base).href,
  jobTitle: "Security Researcher",
  worksFor: {
    "@type": "Organization",
    name: "HiddenLayer",
    url: "https://hiddenlayer.com",
  },
  sameAs: SOCIALS.map((social) => social.href),
}

const jsonLd = isHome
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": new URL("/#website", base).href,
          name: SITE.title,
          description: SITE.description,
          url: new URL("/", base).href,
          inLanguage: SITE.locale,
          author: { "@id": personSchema["@id"] },
        },
        personSchema,
      ],
    }
  : isAbout
    ? {
        "@context": "https://schema.org",
        "@type": "ProfilePage",
        url: canonical.href,
        name: fullTitle,
        description,
        mainEntity: personSchema,
      }
    : undefined
---

<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={SITE.title}>
<meta property="og:locale" content={SITE.locale.replace("-", "_")}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:alt" content={ogTitle}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content={SITE.twitterHandle}>
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={ogTitle}>

{jsonLd && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
)}

{isHome && (
  <DiscordEmbed
    title={SITE.title}
    description={SITE.tagline}
    url={canonical}
    image={{ url: ogImage, description: ogTitle }}
    avatar={author && {
      url: new URL(author.data.avatar, base),
      description: `${author.data.name}'s avatar`,
    }}
    link={{ url: new URL("/cves/", base), label: "Explore my research" }}
  />
)}
