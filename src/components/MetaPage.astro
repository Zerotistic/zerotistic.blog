---
import { getEntry } from "astro:content"
import DiscordEmbed from "@/components/DiscordEmbed.astro"
import { SITE } from "@/consts"
import { pageTitle } from "@/lib/content"
import {
  breadcrumbSchema,
  personId,
  personSchema,
  websiteId,
  type Breadcrumb,
} from "@/lib/schema"

type Props = {
  title?: string
  ogTitle?: string
  description?: string
  ogImage?: string
  breadcrumbs?: Breadcrumb[]
  schema?: Record<string, unknown> | Record<string, unknown>[]
  noindex?: boolean
}

const {
  title,
  ogTitle: explicitOgTitle,
  description = SITE.description,
  ogImage: ogImagePath = SITE.defaultPageImage,
  breadcrumbs,
  schema,
  noindex = false,
} = Astro.props

const base = Astro.site ?? new URL(Astro.url.origin)
const isHome = Astro.url.pathname === "/" && !noindex
const isAbout = Astro.url.pathname.replace(/\/+$/, "") === "/about" && !noindex
const ogTitle = explicitOgTitle ?? title ?? SITE.title
const fullTitle = title
  ? title.includes(SITE.title)
    ? title
    : pageTitle(title)
  : `${SITE.title} — Reverse Engineering, Vulnerability Research & Pwn`
const canonical = new URL(Astro.url.pathname, base)
const ogImage = new URL(ogImagePath, base)
const author = isHome ? await getEntry("authors", "zerotistic") : undefined

const person = personSchema(base)
const graph: Record<string, unknown>[] = []

if (isHome) {
  graph.push(
    {
      "@type": "WebSite",
      "@id": websiteId(base),
      name: SITE.title,
      description: SITE.description,
      url: new URL("/", base).href,
      inLanguage: SITE.locale,
      author: { "@id": personId(base) },
    },
    person,
  )
} else if (isAbout) {
  graph.push({
    "@type": "ProfilePage",
    url: canonical.href,
    name: fullTitle,
    description,
    inLanguage: SITE.locale,
    mainEntity: person,
  })
}

if (schema) {
  if (Array.isArray(schema)) graph.push(...schema)
  else graph.push(schema)
}

const crumbs = !noindex && breadcrumbs ? breadcrumbSchema(breadcrumbs, base) : undefined
if (crumbs) graph.push(crumbs)

const jsonLd =
  graph.length === 0
    ? undefined
    : graph.length === 1
      ? { "@context": "https://schema.org", ...graph[0] }
      : { "@context": "https://schema.org", "@graph": graph }
---

<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={SITE.title}>
<meta property="og:locale" content={SITE.locale.replace("-", "_")}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:alt" content={ogTitle}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content={SITE.twitterHandle}>
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={ogTitle}>

{jsonLd && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
)}

{isHome && (
  <DiscordEmbed
    title={SITE.title}
    description={SITE.tagline}
    url={canonical}
    image={{ url: ogImage, description: ogTitle }}
    avatar={author && {
      url: new URL(author.data.avatar, base),
      description: `${author.data.name}'s avatar`,
    }}
    link={{ url: new URL("/cves/", base), label: "Explore my research" }}
  />
)}
