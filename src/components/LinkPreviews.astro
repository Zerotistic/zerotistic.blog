<dialog id="link-preview" aria-labelledby="link-preview-title">
  <span class="preview-handle" aria-hidden="true"></span>
  <button class="preview-close" type="button" aria-label="Close link preview">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 4 8 8m0-8-8 8" /></svg>
  </button>
  <img class="preview-image" alt="" hidden width="640" height="360" />
  <div class="preview-copy">
    <p class="preview-site"></p>
    <h2 id="link-preview-title"></h2>
    <p class="preview-description"></p>
  </div>
</dialog>

<style is:global>
  /* Touch only: a marker hugging the link and whatever punctuation follows.
     Negative margins keep a 24px target without opening a visible gap or
     growing the line box. */
  .link-preview-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: middle;
    width: 24px;
    height: 24px;
    margin-block: -6px;
    margin-inline: -3px -5px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
    font-size: inherit;

    svg { width: 0.8em; height: 0.8em; fill: none; stroke: currentColor; stroke-width: 1.2; }
    transition: scale var(--dur-press) var(--ease-out);
    &[aria-expanded="true"] { color: var(--foreground); }
    &:active { scale: 0.88; }
  }

  /* With a mouse the preview opens on hover, keep the prose clean. */
  @media (hover: hover) and (pointer: fine) and (width >= 40rem) {
    .link-preview-trigger { display: none; }
  }

  #link-preview {
    position: fixed;
    z-index: 100;
    inset: auto;
    margin: 0;
    padding: 0;
    width: min(360px, calc(100vw - 24px));
    max-width: none;
    max-height: calc(100dvh - 24px);
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--background);
    color: var(--foreground);
    box-shadow: var(--shadow-lg);
    font-family: var(--font-sans);
    line-height: 1.5;

    /* Enter from the link, leave faster and quieter than it arrived. */
    opacity: 0;
    scale: 0.96;
    transition:
      opacity 100ms ease,
      scale 100ms ease,
      display 100ms allow-discrete,
      overlay 100ms allow-discrete;

    &[open] {
      opacity: 1;
      scale: 1;
      transition:
        opacity var(--dur-hover) var(--ease-out),
        scale var(--dur-hover) var(--ease-out);

      @starting-style {
        opacity: 0;
        scale: 0.96;
      }
    }

    .preview-handle {
      display: none;
    }

    .preview-close {
      position: absolute;
      z-index: 1;
      top: 8px;
      right: 8px;
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      border: 1px solid var(--border);
      border-radius: 50%;
      background: var(--background);
      color: var(--foreground);
      cursor: pointer;
      transition: scale var(--dur-press) var(--ease-out);

      svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }
      &:active { scale: 0.92; }
    }

    .preview-image { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
    [hidden] { display: none; }
    .preview-copy { padding: 20px; }
    .preview-site { margin: 0 28px 8px 0; color: var(--muted-foreground); font-family: var(--font-mono); font-size: 11px; overflow-wrap: anywhere; }
    h2 { margin: 0 0 10px; font-size: 18px; font-weight: 550; line-height: 1.3; }
    .preview-description { margin: 0; font-size: 14px; color: var(--muted-foreground); }
    .preview-open {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      cursor: pointer;
    }
    &[data-hover="true"] .preview-close { display: none; }
    &[data-hover="true"] .preview-site { margin-inline-end: 0; }

    &::backdrop { background: rgb(0 0 0 / 0.4); }
  }

  /* On touch it's a bottom sheet: it slides up, the backdrop fades, and it
     can be dragged back down. */
  @media (hover: none), (pointer: coarse), (width < 40rem) {
    #link-preview {
      inset: auto 0 0 !important;
      width: 100%;
      max-height: 80dvh;
      border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
      padding-bottom: env(safe-area-inset-bottom);
      opacity: 1;
      scale: 1;
      translate: 0 100%;
      transition:
        translate 200ms var(--ease-in),
        display 200ms allow-discrete,
        overlay 200ms allow-discrete;

      &[open] {
        translate: 0 0;
        transition: translate 320ms var(--ease-out);

        @starting-style {
          translate: 0 100%;
        }
      }

      &[data-dragging] {
        transition: none;
      }

      &::backdrop {
        opacity: 0;
        transition:
          opacity 200ms ease,
          display 200ms allow-discrete,
          overlay 200ms allow-discrete;
      }

      &[open]::backdrop {
        opacity: 1;

        @starting-style {
          opacity: 0;
        }
      }

      .preview-handle {
        position: absolute;
        z-index: 2;
        inset: 0 3.5rem auto;
        display: block;
        block-size: 24px;
        touch-action: none;

        &::before {
          content: "";
          position: absolute;
          inset: 8px auto auto 50%;
          inline-size: 36px;
          block-size: 4px;
          border-radius: var(--radius-full);
          background: color-mix(in oklab, var(--foreground) 25%, transparent);
          translate: -50% 0;
        }
      }

      .preview-copy { padding: 24px; }
      .preview-close { width: 44px; height: 44px; }
    }
  }
</style>
