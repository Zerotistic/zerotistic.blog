<dialog id="link-preview" aria-labelledby="link-preview-title">
  <span class="preview-handle" aria-hidden="true"></span>
  <button class="preview-close" type="button" aria-label="Close link preview">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 4 8 8m0-8-8 8" /></svg>
  </button>
  <img class="preview-image" alt="" hidden width="640" height="360" />
  <div class="preview-copy">
    <p class="preview-site"></p>
    <h2 id="link-preview-title"></h2>
    <p class="preview-description"></p>
  </div>
</dialog>

<script>
  import type { LinkPreview } from "@/lib/link-previews"
  import { closeOnBack } from "@/lib/overlay-history"

  const panel = document.querySelector<HTMLDialogElement>("#link-preview")!
  const heading = panel.querySelector<HTMLElement>("h2")!
  const description = panel.querySelector<HTMLElement>(".preview-description")!
  const site = panel.querySelector<HTMLElement>(".preview-site")!
  const image = panel.querySelector<HTMLImageElement>("img")!
  const openLink = document.createElement("a")
  openLink.className = "preview-open"
  const touch = matchMedia("(hover: none), (pointer: coarse), (width < 40rem)")
  let current: HTMLButtonElement | undefined
  let hoverTimer: ReturnType<typeof setTimeout> | undefined
  let closeTimer: ReturnType<typeof setTimeout> | undefined
  let savedOverflow: string | undefined
  let explicitOpen = false
  let openedAt = 0

  const cancelTimers = () => {
    clearTimeout(hoverTimer)
    clearTimeout(closeTimer)
  }
  const cleanup = () => {
    current?.setAttribute("aria-expanded", "false")
    if (savedOverflow !== undefined) {
      document.documentElement.style.overflow = savedOverflow
      savedOverflow = undefined
    }
    // Let the exit animation finish before the image goes blank.
    setTimeout(() => {
      if (!panel.open) image.removeAttribute("src")
    }, 250)
  }
  const hide = () => {
    cancelTimers()
    if (panel.open) panel.close()
    cleanup()
  }
  panel.addEventListener("close", () => {
    if (!panel.open) cleanup()
  })
  // On touch the sheet is modal; the back gesture closes it.
  const back = closeOnBack(panel, hide)
  panel.querySelector("button")!.addEventListener("click", hide)
  panel.addEventListener("click", (event) => {
    if (event.target !== panel) return
    const rect = panel.getBoundingClientRect()
    if (event.clientY < rect.top || event.clientX < rect.left || event.clientX > rect.right) hide()
  })
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && panel.open) {
      event.preventDefault()
      const returnFocus = panel.contains(document.activeElement)
      hide()
      if (returnFocus) current?.focus()
    }
  })
  document.addEventListener("pointerdown", (event) => {
    if (!touch.matches && panel.open && !panel.contains(event.target as Node) && event.target !== current) hide()
  })
  const scheduleClose = () => {
    clearTimeout(hoverTimer)
    if (!touch.matches && !panel.contains(document.activeElement)) closeTimer = setTimeout(hide, 180)
  }
  panel.addEventListener("pointerenter", cancelTimers)
  panel.addEventListener("pointerleave", scheduleClose)
  panel.addEventListener("focusout", () => {
    setTimeout(() => {
      if (panel.open && explicitOpen && !touch.matches && !panel.contains(document.activeElement) && document.activeElement !== current) hide()
    }, 0)
  })
  addEventListener("scroll", () => {
    if (panel.open && !touch.matches && performance.now() - openedAt > 150 && !panel.contains(document.activeElement)) hide()
  }, { passive: true })
  addEventListener("resize", hide)
  touch.addEventListener("change", hide)

  const show = (anchor: HTMLAnchorElement, button: HTMLButtonElement, data: LinkPreview, explicit: boolean) => {
    hide()
    current = button
    explicitOpen = explicit
    panel.dataset.hover = String(!explicit && !touch.matches)
    openedAt = performance.now()
    heading.textContent = data.title
    description.textContent = data.description ?? ""
    description.hidden = !data.description
    const url = new URL(anchor.href)
    site.textContent = url.host === location.host ? "zerotistic.blog" : url.hostname.replace(/^www\./, "")
    openLink.href = anchor.href
    openLink.setAttribute("aria-label", `Open ${data.title}`)
    openLink.target = anchor.target
    openLink.rel = "noopener noreferrer"
    if (!openLink.isConnected) panel.querySelector(".preview-copy")!.append(openLink)
    // Images are build assets or cached copies, never third-party hover requests.
    image.hidden = !data.image
    if (data.image) image.src = data.image
    image.onerror = () => { image.hidden = true }
    button.setAttribute("aria-expanded", "true")
    if (touch.matches) {
      panel.showModal()
      back.opened()
      savedOverflow = document.documentElement.style.overflow
      document.documentElement.style.overflow = "hidden"
      // Short sheets drag from anywhere; long ones scroll and drag by the handle.
      panel.style.touchAction = panel.scrollHeight > panel.clientHeight ? "" : "none"
    } else {
      const focus = document.activeElement as HTMLElement | null
      panel.show()
      const rect = anchor.getBoundingClientRect()
      // Layout size, not the box mid scale animation.
      const height = panel.offsetHeight
      const width = panel.offsetWidth
      const left = Math.max(12, Math.min(rect.left, innerWidth - width - 12))
      const below = rect.bottom + height + 12 < innerHeight
      const top = Math.max(12, below ? rect.bottom + 10 : rect.top - height - 10)
      panel.style.left = `${left}px`
      panel.style.top = `${top}px`
      // Grow out of the link that opened it.
      const originX = Math.min(Math.max(rect.left + rect.width / 2 - left, 0), width)
      panel.style.transformOrigin = `${originX}px ${below ? 0 : height}px`
      if (!explicit) {
        if (focus && focus !== document.body) focus.focus({ preventScroll: true })
        else (document.activeElement as HTMLElement | null)?.blur()
      }
    }
  }

  openLink.addEventListener("click", () => {
    back.forget()
    hide()
  })

  // Touch: the sheet follows a downward drag and closes when thrown or pulled
  // past a third of its height; otherwise it springs back.
  let drag: { id: number; y: number; t: number; dy: number; v: number } | undefined
  let dragged = false
  panel.addEventListener("pointerdown", (event) => {
    if (!touch.matches || event.pointerType === "mouse" || !panel.open) return
    const onHandle = (event.target as Element).closest(".preview-handle")
    if (!onHandle && panel.scrollTop > 0) return
    drag = { id: event.pointerId, y: event.clientY, t: event.timeStamp, dy: 0, v: 0 }
    dragged = false
  })
  panel.addEventListener("pointermove", (event) => {
    if (!drag || event.pointerId !== drag.id) return
    const dy = event.clientY - drag.y
    if (!dragged && dy < 6) return
    if (!dragged) panel.setPointerCapture(drag.id)
    dragged = true
    const dt = Math.max(1, event.timeStamp - drag.t)
    drag.v = (dy - drag.dy) / dt
    drag.dy = dy
    drag.t = event.timeStamp
    // Resist pulling up past the resting position.
    panel.style.translate = `0 ${dy > 0 ? dy : dy / 4}px`
    panel.dataset.dragging = ""
  })
  const release = (event: PointerEvent) => {
    if (!drag || event.pointerId !== drag.id) return
    const { dy, v } = drag
    drag = undefined
    delete panel.dataset.dragging
    if (!dragged) return
    if (dy > panel.offsetHeight / 3 || v > 0.5) hide()
    panel.style.translate = ""
  }
  panel.addEventListener("pointerup", release)
  panel.addEventListener("pointercancel", release)
  // A drag is not a tap on the link underneath.
  panel.addEventListener("click", (event) => {
    if (!dragged) return
    dragged = false
    event.preventDefault()
    event.stopPropagation()
  }, true)

  document.querySelectorAll<HTMLElement>("article[data-link-previews]").forEach((article) => {
    const previews: Record<string, LinkPreview> = JSON.parse(article.dataset.linkPreviews || "{}")
    article.querySelectorAll<HTMLAnchorElement>("prose-content a[href]").forEach((anchor) => {
      const href = anchor.getAttribute("href")!
      if (href.startsWith("#") || anchor.closest(".footnotes, pre, code, h1, h2, h3, h4, h5, h6") || anchor.querySelector("img") || anchor.hasAttribute("data-footnote-ref")) return
      const url = new URL(anchor.href)
      if (!["http:", "https:"].includes(url.protocol)) return
      url.hash = ""
      url.pathname = url.pathname.replace(/\/$/, "") || "/"
      const key = [location.origin, "https://zerotistic.blog"].includes(url.origin) ? url.pathname + url.search : url.href
      const data = previews[key]
      if (!data?.title) return
      const button = document.createElement("button")
      button.type = "button"
      button.className = "link-preview-trigger"
      button.setAttribute("aria-label", `Preview: ${anchor.textContent?.trim() || data.title}`)
      button.setAttribute("aria-haspopup", "dialog")
      button.setAttribute("aria-expanded", "false")
      button.setAttribute("aria-controls", "link-preview")
      button.innerHTML = '<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2.5" y="3" width="11" height="10" rx="2"/><path d="M5 6h6M5 9h4"/></svg>'
      anchor.after(button)
      button.addEventListener("click", () => {
        if (current === button && panel.open) hide()
        else show(anchor, button, data, true)
      })
      for (const element of [anchor, button]) {
        element.addEventListener("pointerenter", (event) => {
          if (touch.matches || !(event instanceof PointerEvent) || event.pointerType !== "mouse") return
          cancelTimers()
          if (current === button && panel.open) return
          hoverTimer = setTimeout(() => show(anchor, button, data, false), 500)
        })
        element.addEventListener("pointerleave", scheduleClose)
      }
      // Without a pointer the trigger is hidden, so keyboard focus on the
      // link behaves like hovering it.
      anchor.addEventListener("focus", () => {
        if (touch.matches || !anchor.matches(":focus-visible")) return
        cancelTimers()
        if (current === button && panel.open) return
        hoverTimer = setTimeout(() => show(anchor, button, data, false), 500)
      })
      anchor.addEventListener("blur", scheduleClose)
    })
  })
</script>

<style is:global>
  /* Touch only: a marker hugging the link and whatever punctuation follows.
     Negative margins keep a 24px target without opening a visible gap or
     growing the line box. */
  .link-preview-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: middle;
    width: 24px;
    height: 24px;
    margin-block: -6px;
    margin-inline: -3px -5px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
    font-size: inherit;

    svg { width: 0.8em; height: 0.8em; fill: none; stroke: currentColor; stroke-width: 1.2; }
    transition: scale var(--dur-press) var(--ease-out);
    &[aria-expanded="true"] { color: var(--foreground); }
    &:active { scale: 0.88; }
  }

  /* With a mouse the preview opens on hover, keep the prose clean. */
  @media (hover: hover) and (pointer: fine) and (width >= 40rem) {
    .link-preview-trigger { display: none; }
  }

  #link-preview {
    position: fixed;
    z-index: 100;
    inset: auto;
    margin: 0;
    padding: 0;
    width: min(360px, calc(100vw - 24px));
    max-width: none;
    max-height: calc(100dvh - 24px);
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--background);
    color: var(--foreground);
    box-shadow: var(--shadow-lg);
    font-family: var(--font-sans);
    line-height: 1.5;

    /* Enter from the link, leave faster and quieter than it arrived. */
    opacity: 0;
    scale: 0.96;
    transition:
      opacity 100ms ease,
      scale 100ms ease,
      display 100ms allow-discrete,
      overlay 100ms allow-discrete;

    &[open] {
      opacity: 1;
      scale: 1;
      transition:
        opacity var(--dur-hover) var(--ease-out),
        scale var(--dur-hover) var(--ease-out);

      @starting-style {
        opacity: 0;
        scale: 0.96;
      }
    }

    .preview-handle {
      display: none;
    }

    .preview-close {
      position: absolute;
      z-index: 1;
      top: 8px;
      right: 8px;
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;
      border: 1px solid var(--border);
      border-radius: 50%;
      background: var(--background);
      color: var(--foreground);
      cursor: pointer;
      transition: scale var(--dur-press) var(--ease-out);

      svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }
      &:active { scale: 0.92; }
    }

    .preview-image { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
    [hidden] { display: none; }
    .preview-copy { padding: 20px; }
    .preview-site { margin: 0 28px 8px 0; color: var(--muted-foreground); font-family: var(--font-mono); font-size: 11px; overflow-wrap: anywhere; }
    h2 { margin: 0 0 10px; font-size: 18px; font-weight: 550; line-height: 1.3; }
    .preview-description { margin: 0; font-size: 14px; color: var(--muted-foreground); }
    .preview-open {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      cursor: pointer;
    }
    &[data-hover="true"] .preview-close { display: none; }
    &[data-hover="true"] .preview-site { margin-inline-end: 0; }

    &::backdrop { background: rgb(0 0 0 / 0.4); }
  }

  /* On touch it's a bottom sheet: it slides up, the backdrop fades, and it
     can be dragged back down. */
  @media (hover: none), (pointer: coarse), (width < 40rem) {
    #link-preview {
      inset: auto 0 0 !important;
      width: 100%;
      max-height: 80dvh;
      border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
      padding-bottom: env(safe-area-inset-bottom);
      opacity: 1;
      scale: 1;
      translate: 0 100%;
      transition:
        translate 200ms var(--ease-in),
        display 200ms allow-discrete,
        overlay 200ms allow-discrete;

      &[open] {
        translate: 0 0;
        transition: translate 320ms var(--ease-out);

        @starting-style {
          translate: 0 100%;
        }
      }

      &[data-dragging] {
        transition: none;
      }

      &::backdrop {
        opacity: 0;
        transition:
          opacity 200ms ease,
          display 200ms allow-discrete,
          overlay 200ms allow-discrete;
      }

      &[open]::backdrop {
        opacity: 1;

        @starting-style {
          opacity: 0;
        }
      }

      .preview-handle {
        position: absolute;
        z-index: 2;
        inset: 0 3.5rem auto;
        display: block;
        block-size: 24px;
        touch-action: none;

        &::before {
          content: "";
          position: absolute;
          inset: 8px auto auto 50%;
          inline-size: 36px;
          block-size: 4px;
          border-radius: var(--radius-full);
          background: color-mix(in oklab, var(--foreground) 25%, transparent);
          translate: -50% 0;
        }
      }

      .preview-copy { padding: 24px; }
      .preview-close { width: 44px; height: 44px; }
    }
  }
</style>
