---
import LinkIcon from "@/assets/icons/link.svg"

type Props = { id: string; anchor?: string }
const { id, anchor = id.toLowerCase() } = Astro.props
const publishedId = /^(CVE-\d{4}-\d+|GHSA-[\da-z-]+)$/.test(id)
---

<span class="cve-reference">
  <code>{id}</code>
  <a
    href={`#${anchor}`}
    data-icon-button
    aria-label={`Permalink to ${id}`}
    title="Permalink to finding"
  >
    <LinkIcon aria-hidden="true" />
  </a>
  {publishedId && (
    <span class="copy-id">
      <button type="button" data-icon-button data-copy-id={id} aria-label={`Copy ${id} ID`} title="Copy finding ID" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="8" y="8" width="12" height="12" rx="2" />
          <path d="M16 8V4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h4" />
        </svg>
      </button>
      <span class="copy-status" role="status" aria-live="polite" aria-atomic="true"></span>
    </span>
  )}
</span>

<style>
  .cve-reference {
    display: inline-flex;
    align-items: center;
    gap: 0;
    min-inline-size: 0;
  }

  code {
    margin-inline-end: var(--space-3xs);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0;
    color: var(--muted-foreground);
  }

  a,
  button {
    color: var(--muted-foreground);

    &:hover,
    &:focus-visible {
      color: var(--accent);
    }
  }

  .copy-id {
    position: relative;
    display: inline-flex;
  }

  button[hidden] {
    display: none;
  }

  .copy-status:not(:empty) {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-end: 0;
    z-index: 2;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    font: var(--text-meta) / 1.5 var(--font-mono);
    white-space: nowrap;
    pointer-events: none;
  }

  @media (any-pointer: coarse) {
    a,
    button {
      min-block-size: 2.75rem;
      min-inline-size: 2.75rem;
    }
  }
</style>

<script>
  import { copyText } from "@/lib/clipboard"

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-copy-id]",
  )) {
    const status =
      button.parentElement?.querySelector<HTMLElement>(".copy-status")
    if (!status) continue
    button.hidden = false
    let timer: ReturnType<typeof setTimeout>
    button.addEventListener("click", async () => {
      clearTimeout(timer)
      status.textContent = ""
      const copied = await copyText(button.dataset.copyId!)
      status.textContent = copied ? "Copied" : "Couldn’t copy"
      timer = setTimeout(() => {
        status.textContent = ""
      }, 2000)
    })
  }
</script>
