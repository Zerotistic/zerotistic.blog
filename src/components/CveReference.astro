---
type Props = { id: string; anchor?: string }
const { id, anchor = id.toLowerCase() } = Astro.props
const publishedId = /^(CVE-\d{4}-\d+|GHSA-[\da-z-]+)$/.test(id)
---

<span class="cve-reference">
  <code>{id}</code>
  <a
    href={`#${anchor}`}
    data-icon-button
    aria-label={`Permalink to ${id}`}
    data-tooltip="Permalink to finding"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <use href="#cve-icon-link" />
    </svg>
  </a>
  {publishedId && (
    <span class="copy-id">
      <button type="button" data-icon-button data-icon-swap data-copy-id={id} aria-label={`Copy ${id} ID`} data-tooltip="Copy finding ID" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <use href="#cve-icon-copy" />
        </svg>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <use href="#cve-icon-check" />
        </svg>
      </button>
      <span class="copy-status" role="status" aria-live="polite" aria-atomic="true"></span>
    </span>
  )}
</span>

<style>
  .cve-reference {
    display: inline-flex;
    align-items: center;
    gap: 0;
    min-inline-size: 0;
  }

  code {
    margin-inline-end: var(--space-3xs);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0;
    color: var(--muted-foreground);
  }

  a,
  button {
    color: var(--muted-foreground);

    &:focus-visible {
      color: var(--accent);
    }

    @media (hover: hover) {
      &:hover {
        color: var(--accent);
      }
    }
  }

  .copy-id {
    position: relative;
    display: inline-flex;
  }

  button[hidden] {
    display: none;
  }

  /* Success shows as the check in the button; the text is for screen
     readers. Only a failure needs words on screen. */
  .copy-status:not([data-failed]) {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .copy-status[data-failed]:not(:empty) {
    position: absolute;
    inset-block-start: 100%;
    inset-inline-end: 0;
    z-index: 2;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    font: var(--text-meta) / 1.5 var(--font-mono);
    white-space: nowrap;
    pointer-events: none;
  }

  @media (any-pointer: coarse) {
    a,
    button {
      min-block-size: 2.75rem;
      min-inline-size: 2.75rem;
    }
  }
</style>

<script>
  import { copyText } from "@/lib/clipboard"
  import { haptic } from "@/lib/haptics"

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-copy-id]",
  )) {
    const status =
      button.parentElement?.querySelector<HTMLElement>(".copy-status")
    if (!status) continue
    button.hidden = false
    let timer: ReturnType<typeof setTimeout>
    button.addEventListener("click", async () => {
      haptic("success")
      clearTimeout(timer)
      status.textContent = ""
      const copied = await copyText(button.dataset.copyId!)
      status.textContent = copied ? "Copied" : "Couldn’t copy"
      status.toggleAttribute("data-failed", !copied)
      button.toggleAttribute("data-swapped", copied)
      timer = setTimeout(() => {
        status.textContent = ""
        button.removeAttribute("data-swapped")
      }, 1500)
    })
  }
</script>
