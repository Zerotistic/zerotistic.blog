<div class="resume" hidden>
  <a class="resume-go" href="#">
    <svg
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M8 3v9m-4-4 4 4 4-4" />
    </svg>
    <span>Continue at <strong class="resume-title"></strong></span>
  </a>
  <button
    type="button"
    class="resume-dismiss"
    aria-label="Start from the top instead"
  >
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="m4 4 8 8m0-8-8 8" />
    </svg>
  </button>
</div>

<script>
  // Long posts remember the section you were in. Coming back later, a pill
  // offers to pick up there. Finishing the post (or 60 days) forgets it.
  type Place = { id: string; title: string; at: number }

  const key = `resume:${location.pathname.replace(/\/+$/, "")}`
  const maxAge = 60 * 24 * 60 * 60 * 1000
  const pill = document.querySelector<HTMLElement>(".resume")!
  const go = pill.querySelector<HTMLAnchorElement>(".resume-go")!
  const title = pill.querySelector<HTMLElement>(".resume-title")!
  const dismiss = pill.querySelector<HTMLButtonElement>(".resume-dismiss")!

  const read = (): Place | undefined => {
    try {
      const place = JSON.parse(
        localStorage.getItem(key) ?? "null",
      ) as Place | null
      return place && Date.now() - place.at < maxAge ? place : undefined
    } catch {
      return undefined
    }
  }
  const write = (place: Place | null) => {
    try {
      if (place) localStorage.setItem(key, JSON.stringify(place))
      else localStorage.removeItem(key)
    } catch {}
  }

  const progress = () => {
    const max = document.documentElement.scrollHeight - innerHeight
    return max > 0 ? scrollY / max : 1
  }

  // The current section is whatever the table of contents marks.
  const current = () =>
    document.querySelector<HTMLAnchorElement>("page-toc a[aria-current]")

  let saveTimer = 0
  const save = () => {
    const ratio = progress()
    if (ratio > 0.95) return write(null)
    const link = current()
    if (ratio < 0.06 || !link || link.hash === "#introduction") return
    write({
      id: decodeURIComponent(link.hash.slice(1)),
      title: link.textContent?.trim() ?? "",
      at: Date.now(),
    })
  }
  addEventListener(
    "scroll",
    () => {
      clearTimeout(saveTimer)
      saveTimer = window.setTimeout(save, 400)
    },
    { passive: true },
  )
  addEventListener("pagehide", save)

  const hide = () => pill.removeAttribute("data-visible")

  const navigation = performance.getEntriesByType("navigation")[0] as
    | PerformanceNavigationTiming
    | undefined
  const place = read()
  const target = place && document.getElementById(place.id)
  // Back and forward already restore the position; a link with a #section
  // already says where to go.
  if (
    place &&
    target &&
    !location.hash &&
    navigation?.type !== "back_forward"
  ) {
    title.textContent = place.title
    go.href = `#${encodeURIComponent(place.id)}`
    setTimeout(() => {
      if (scrollY > innerHeight) return
      pill.hidden = false
      pill.setAttribute("data-visible", "")
    }, 500)

    go.addEventListener("click", (event) => {
      event.preventDefault()
      // Straight there (gliding through half a post would take ages), then
      // the landing glow shows where you are.
      target.scrollIntoView({ block: "start" })
      dispatchEvent(new CustomEvent("site:land", { detail: target }))
      hide()
    })
    dismiss.addEventListener("click", () => {
      write(null)
      hide()
    })
    // Reading on from the top means the offer is no longer needed.
    addEventListener(
      "scroll",
      () => {
        if (!pill.hidden && scrollY > innerHeight) hide()
      },
      { passive: true },
    )
  }
</script>

<style is:global>
  .resume {
    position: fixed;
    inset-block-end: calc(var(--grid-gutter) + env(safe-area-inset-bottom));
    inset-inline-start: 50%;
    z-index: 20;
    display: flex;
    align-items: center;
    max-inline-size: min(32rem, calc(100vw - 2 * var(--grid-gutter)));
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--background);
    box-shadow: var(--shadow-lg);
    font-size: var(--step--1);
    translate: -50% 1rem;
    opacity: 0;
    transition:
      opacity var(--dur-state) var(--ease-in),
      translate var(--dur-state) var(--ease-in),
      display var(--dur-state) allow-discrete;

    &:not([data-visible]) {
      display: none;
    }

    &[data-visible] {
      translate: -50% 0;
      opacity: 1;
      transition:
        opacity 300ms var(--ease-out),
        translate 300ms var(--ease-out);

      @starting-style {
        translate: -50% 1rem;
        opacity: 0;
      }
    }

    svg {
      flex: none;
      inline-size: 1rem;
      block-size: 1rem;
    }
  }

  .resume-go {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    min-inline-size: 0;
    min-block-size: 2.75rem;
    padding-inline: var(--space-s) var(--space-2xs);
    color: var(--muted-foreground);
    text-decoration: none;

    span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--foreground);
      font-weight: var(--font-weight-medium);
    }

    svg {
      color: var(--accent);
    }
  }

  .resume-dismiss {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-full);
    color: var(--muted-foreground);
    cursor: pointer;

    svg {
      inline-size: 0.875rem;
      block-size: 0.875rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
    }

    @media (hover: hover) {
      &:hover {
        color: var(--foreground);
      }
    }
  }
</style>
