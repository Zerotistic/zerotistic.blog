---
import { SOCIALS } from "@/consts"
---

<ul class="contact-links" role="list" aria-label="Find me online">
  {SOCIALS.map(({ href, label, handle, icon: Icon }) => (
    <li>
      <a
        class="contact-link"
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${label}: ${handle} (opens in a new tab)`}
      >
        <Icon class="contact-logo" aria-hidden="true" />
        <span class="contact-platform">
          {label} <span class="contact-arrow" aria-hidden="true">↗</span>
        </span>
        <span class="contact-handle">{handle}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    margin-block-start: var(--space-2xs);
    list-style: none;
    padding: 0;
  }

  li {
    min-inline-size: 0;
  }

  .contact-link {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    align-items: center;
    gap: 0.125rem var(--space-xs);
    inline-size: fit-content;
    min-block-size: 2.75rem;
    padding-block: 0.125rem;
    color: var(--foreground);
    text-decoration: none;
    transition: color 160ms ease;

    &:hover,
    &:focus-visible {
      color: var(--accent);
    }

    &:hover .contact-platform,
    &:focus-visible .contact-platform {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.25em;
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
  }

  .contact-logo {
    grid-column: 1;
    grid-row: 1 / 3;
    justify-self: center;
    inline-size: 1.125rem;
    block-size: 1.125rem;
  }

  .contact-platform,
  .contact-handle {
    font-family: var(--font-mono);
    letter-spacing: 0;
  }

  .contact-platform {
    grid-column: 2;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .contact-arrow {
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1;
  }

  .contact-link:hover .contact-arrow,
  .contact-link:focus-visible .contact-arrow {
    color: var(--accent);
  }

  .contact-handle {
    grid-column: 2;
    min-inline-size: 0;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  @media (width < 40rem) {
    .contact-links {
      flex-direction: column;
      gap: var(--space-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link {
      transition: none;
    }
  }
</style>
