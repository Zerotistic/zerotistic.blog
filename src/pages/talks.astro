---
import { Image } from "astro:assets"
import MetaPage from "@/components/MetaPage.astro"
import PageHeader from "@/components/PageHeader.astro"
import TalkVideo from "@/components/TalkVideo.astro"
import { talks } from "@/data/talks"
import Layout from "@/layouts/Layout.astro"
---

<Layout wide>
  <MetaPage
    slot="head"
    title="Talks"
    description="Conference and meetup talks by zerotistic, on vulnerability research and reverse engineering. Recordings, slides, and notes."
  />

  <div class="talks-page">
    <PageHeader
      title="talks"
      description="Conference and meetup talks, with recordings, slides, and notes."
    />

    <ol class="talk-list" role="list" aria-label="Talks, newest first">
      {talks.map((talk) => (
        <li>
          <article class="talk" id={talk.id} aria-labelledby={`${talk.id}-heading`}>
            <header class="talk-heading">
              <div class="talk-meta">
                <span class="talk-event">
                  {talk.eventHref ? (
                    <a href={talk.eventHref} target="_blank" rel="noopener noreferrer">
                      {talk.event}<span class="link-arrow" aria-hidden="true"> ↗</span>
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  ) : talk.event}
                </span>
                <time datetime={talk.date}>{talk.dateLabel}</time>
                <span>{talk.location}</span>
                <span class="talk-languages">
                  {talk.languages.map(({ flag, label }) => (
                    <span role="img" aria-label={label} title={label}>{flag}</span>
                  ))}
                </span>
              </div>
              <h2 id={`${talk.id}-heading`}>{talk.title}</h2>
            </header>

            <div class="talk-body">
              {talk.kind === "recording" ? (
                <TalkVideo
                  videoId={talk.videoId}
                  title={talk.title}
                  poster={talk.preview}
                  duration={talk.duration}
                />
              ) : (
                <a class="slide-preview" href={talk.href} aria-label={`Read the slides and notes for ${talk.title}`}>
                  <Image
                    src={talk.preview}
                    width={480}
                    widths={[320, 480, 640, 960]}
                    sizes="(max-width: 639px) calc(100vw - 48px), (max-width: 1023px) 48vw, 432px"
                    alt=""
                    loading="lazy"
                    decoding="async"
                    quality={85}
                  />
                </a>
              )}

              <div class="talk-copy">
                <p class="talk-description">{talk.description}</p>
                <div class="talk-links">
                  {talk.kind === "recording" ? (
                    <a href={talk.href} target="_blank" rel="noopener noreferrer">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                        <rect x="2" y="5" width="20" height="14" rx="4" />
                        <path d="m10 9 5 3-5 3Z" />
                      </svg>
                      <span>Watch on YouTube</span>
                      <span class="link-arrow" aria-hidden="true">↗</span>
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  ) : (
                    <a href={talk.href}>
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8Z" />
                        <path d="M14 3v5h5M9 12h6m-6 4h6" />
                      </svg>
                      <span>Slides &amp; notes</span>
                      <span class="link-arrow" aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ol>
  </div>
</Layout>

<style>
  .talk-list {
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--border);
  }

  .talk-list > li {
    border-block-end: 1px solid var(--border);
  }

  .talk {
    padding-block: var(--space-l);
    scroll-margin-block-start: var(--space-xl);
  }

  .talk-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3xs) var(--space-s);
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    line-height: 1.6;
  }

  .talk-event {
    color: var(--foreground);
  }

  .talk-meta time {
    font-variant-numeric: tabular-nums;
  }

  .talk-languages {
    display: inline-flex;
    gap: var(--space-2xs);
    font-size: 1rem;
    line-height: 1;
  }

  h2 {
    margin-block-start: var(--space-xs);
    color: var(--foreground);
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
    line-height: 1.35;
    text-wrap: pretty;
  }

  .talk-body {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-m);
    margin-block-start: var(--space-m);
  }

  .slide-preview {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: #000;
    transition: border-color 160ms ease;
  }

  .slide-preview img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .slide-preview:hover {
    border-color: var(--accent);
  }

  .slide-preview:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
  }

  .talk-copy {
    min-inline-size: 0;
  }

  .talk-description {
    color: var(--prose-foreground);
    font-size: var(--step--1);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .talk-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-m);
    margin-block-start: var(--space-s);
    font-size: var(--step--1);
  }

  .talk-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-block-size: 2.75rem;
    color: var(--foreground);
    text-decoration-color: var(--border);
  }

  .talk-links a:hover {
    text-decoration-color: var(--accent);
  }

  .talk-links svg {
    flex: none;
    color: var(--muted-foreground);
  }

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (width < 40rem) {
    .talk-body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-s);
    }

    .talk-meta {
      column-gap: var(--space-xs);
    }

    .talk-links {
      margin-block-start: var(--space-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide-preview {
      transition: none;
    }
  }
</style>
