---
import MetaPost from "@/components/MetaPost.astro"
import LinkPreviews from "@/components/LinkPreviews.astro"
import { postLinkPreviews } from "@/lib/link-previews"
import PostActions from "@/components/PostActions.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import SeriesReader from "@/components/SeriesReader.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import Layout from "@/layouts/Layout.astro"
import {
  getPosts,
  getSubposts,
  pageTitle,
  titleHtml,
  titleText,
} from "@/lib/content"
import { formatDate, isSubpost, readingTime, subpostSlug } from "@/lib/utils"
import { Image } from "astro:assets"
import { getEntries, render, type CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const posts = await getPosts()
  const series = await getSubposts()
  return posts.flatMap((parent, i) => {
    const chain = [parent, ...(series.get(parent.id) ?? [])]
    return chain.map((post) => ({
      params: { id: post.id },
      props: { post, chain, prev: posts[i + 1], next: posts[i - 1] },
    }))
  })
}

type Props = {
  post: CollectionEntry<"blog">
  chain: CollectionEntry<"blog">[]
  prev?: CollectionEntry<"blog">
  next?: CollectionEntry<"blog">
}

const { post, chain, prev, next } = Astro.props
const [parent] = chain
const rendered = await Promise.all(
  chain.map(async (entry) => ({
    entry,
    ...(await render(entry)),
    authors: await getEntries(entry.data.authors),
    linkPreviews: await postLinkPreviews(entry),
  })),
)

const sections = rendered.map(({ entry, headings }, i) => ({
  id: i === 0 ? undefined : subpostSlug(entry.id),
  label: entry.data.title,
  open: entry.id === post.id,
  headings: headings.filter(
    ({ depth, text }) => depth >= 2 && depth <= 4 && text.trim(),
  ),
}))
const hasToc =
  sections.length > 1 || sections.some(({ headings }) => headings.length > 0)

const crumbs: { label: string; href: string }[] = []
if (chain.length > 1) {
  crumbs.push({
    label: titleText(parent.data.title),
    href: `/posts/${parent.id}`,
  })
  if (isSubpost(post.id)) {
    crumbs.push({
      label: titleText(post.data.title),
      href: `/posts/${post.id}`,
    })
  }
}
---

<Layout crumbs={crumbs}>
  <MetaPost
    slot="head"
    post={post}
    canonical={isSubpost(post.id) ? `/posts/${parent.id}` : undefined}
  />
  {hasToc && (
      <TableOfContents
        slot="toc"
        title={parent.data.title}
        sections={sections}
      />
    )}
  <PostActions slot="actions" prev={prev} next={next} />
  <ScrollToTop floating />
  <LinkPreviews />
  {rendered.map(({ entry, Content, authors, linkPreviews }, i) => (
      <article
        id={i === 0 ? undefined : subpostSlug(entry.id)}
        data-url={`/posts/${entry.id}`}
        data-title={pageTitle(entry.data.title)}
        data-link-previews={JSON.stringify(linkPreviews)}
        data-embedded={i > 0 || undefined}
      >
        <header>
          <h1 set:html={titleHtml(entry.data.title)} />
          <p>{entry.data.description}</p>
          <post-meta>
            {authors.length > 0 && (
              <post-authors>
                <author-avatars>
                  {authors.map((author) => (
                    <img
                      src={author.data.avatar}
                      alt={author.data.name}
                      width="18"
                      height="18"
                    />
                  ))}
                </author-avatars>
                <author-names>
                  {authors.map((author, j) => (
                    <>{j > 0 && ", "}{author.data.name}</>
                  ))}
                </author-names>
              </post-authors>
            )}
            <time datetime={entry.data.date.toISOString()}
              >{formatDate(entry.data.date)}</time
            >
            <reading-time>{readingTime(entry.body ?? "")}</reading-time>
          </post-meta>
            {entry.data.tags && (
              <post-tags>
                {entry.data.tags.map((tag) => (
                  <a href={`/tags/${tag}`}>#{tag}</a>
                ))}
              </post-tags>
            )}
          {entry.data.facts && (
            <dl class="fact-table">
              {entry.data.facts.event && (
                <div class="fact-row"><dt>event</dt><dd>{entry.data.facts.event}</dd></div>
              )}
              {entry.data.facts.category && (
                <div class="fact-row"><dt>category</dt><dd>{entry.data.facts.category}</dd></div>
              )}
              {entry.data.facts.target && (
                <div class="fact-row"><dt>target</dt><dd>{entry.data.facts.target}</dd></div>
              )}
              {entry.data.facts.tools && (
                <div class="fact-row"><dt>tools</dt><dd>{entry.data.facts.tools.join(", ")}</dd></div>
              )}
            </dl>
          )}
        </header>
        {entry.data.image && (
          <post-banner>
            <Image
              src={entry.data.image}
              alt={entry.data.title}
              width={1200}
              height={630}
              priority={entry.id === post.id || undefined}
            />
          </post-banner>
        )}
        <prose-content>
          <Content />
        </prose-content>
      </article>
    ))}
  {chain.length > 1 && <SeriesReader />}
</Layout>

<style>
  article[data-embedded] {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-xl);
    border-block-start: 2px solid var(--border);
    scroll-margin-block-start: calc(-2px - 0.2 * var(--step-2));

    header h1 {
      font-size: var(--step-2);
    }
  }

  header {
    margin-block-end: var(--space-xl);

    h1 {
      font-size: clamp(1.75rem, 1.2rem + 1.5vw, 2.5rem);
      line-height: 1.18;
      font-weight: var(--font-weight-medium);
    }

    post-meta {
      --underline: var(--muted-foreground);

      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4em 0.6em;
      margin-block-start: var(--space-m);
      font-family: var(--font-mono);
      font-size: var(--step--1);
      letter-spacing: 0;
      color: var(--muted-foreground);

      time,
      reading-time {
        font-variant-numeric: tabular-nums;
      }

      time ~ reading-time::before {
        content: "·";
        margin-inline-end: var(--space-3xs);
      }

      post-authors {
        display: flex;
        align-items: center;
        gap: var(--space-3xs);

        author-avatars {
          display: flex;
          margin-block-end: -0.1em;

          img {
            border-radius: var(--radius-full);
            box-shadow: 0 0 0 1.5px var(--background);

            &:not(:first-child) {
              margin-inline-start: -0.375rem;
            }
          }
        }
      }

      post-authors ~ time::before {
        content: "·";
        margin-inline-end: var(--space-3xs);
      }

      a {
        color: var(--foreground);
      }
    }

    > post-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4em 0.85em;
      margin-block-start: var(--space-xs);
      font-family: var(--font-mono);
      font-size: var(--step--1);
      color: var(--muted-foreground);

      a:hover {
        color: var(--foreground);
      }
    }

    > p {
      margin-block-start: var(--space-s);
      font-size: var(--step-0);
      line-height: 1.6;
      color: var(--muted-foreground);
    }

    .fact-table {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-m);
      margin-block-start: var(--space-m);
      padding-block-start: var(--space-m);
      font-size: var(--step--1);
      border-block-start: 1px solid var(--border);

      @media (width < 40rem) {
        grid-template-columns: 1fr;
        gap: var(--space-s);
      }

      .fact-row {
        display: grid;
        align-content: start;
        gap: 0.45em;
        min-width: 0;
      }

      dt {
        font-family: var(--font-mono);
        color: var(--muted-foreground);
        font-size: 0.8em;
        text-transform: uppercase;
        letter-spacing: 0.07em;
      }

      dd {
        color: var(--foreground);
        text-wrap: pretty;
        overflow-wrap: anywhere;
      }
    }
  }

  post-banner {
    display: block;
    margin-block-end: var(--space-m);

    :global(img) {
      inline-size: 100%;
      block-size: auto;
      border-radius: var(--radius-lg);
      outline: 1px solid light-dark(rgb(0 0 0 / 0.08), rgb(255 255 255 / 0.08));
      outline-offset: -1px;
    }
  }
</style>
