---
import "@/styles/typography-headings.css"
import "@/styles/typography-inline.css"
import "@/styles/typography-lists.css"
import "@/styles/typography-block.css"
import "@/styles/typography-tables.css"
import "@/styles/typography-math.css"
import "@/styles/callout.css"
import siriCss from "@/styles/siri.css?url"
import thoughtsCss from "@/styles/thoughts.css?url"
import ImageViewer from "@/components/ImageViewer.astro"
import SiriClock from "@/components/SiriClock.astro"
import SiriDemo from "@/components/SiriDemo.astro"
import ThoughtsMarginalia from "@/components/ThoughtsMarginalia.astro"
import MetaPost from "@/components/MetaPost.astro"
import LinkPreviews from "@/components/LinkPreviews.astro"
import { postLinkPreviews } from "@/lib/link-previews"
import PostNavigation from "@/components/PostNavigation.astro"
import CodeTools from "@/components/CodeTools.astro"
import HeadingLinks from "@/components/HeadingLinks.astro"
import QuoteLink from "@/components/QuoteLink.astro"
import ResumeReading from "@/components/ResumeReading.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import SeriesReader from "@/components/SeriesReader.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import Layout from "@/layouts/Layout.astro"
import {
  dateTransition,
  getPosts,
  getSubposts,
  pageTitle,
  titleHtml,
  titleText,
  titleTransition,
} from "@/lib/content"
import { formatDate, isSubpost, readingTime, subpostSlug } from "@/lib/utils"
import { Image } from "astro:assets"
import { getEntries, render, type CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const posts = await getPosts()
  const series = await getSubposts()
  return posts.flatMap((parent, i) => {
    const chain = [parent, ...(series.get(parent.id) ?? [])]
    return chain.map((post) => ({
      params: { id: post.id },
      props: { post, chain, prev: posts[i + 1], next: posts[i - 1] },
    }))
  })
}

type Props = {
  post: CollectionEntry<"blog">
  chain: CollectionEntry<"blog">[]
  prev?: CollectionEntry<"blog">
  next?: CollectionEntry<"blog">
}

const { post, chain, prev, next } = Astro.props
const [parent] = chain
const rendered = await Promise.all(
  chain.map(async (entry) => ({
    entry,
    ...(await render(entry)),
    authors: await getEntries(entry.data.authors),
    linkPreviews: await postLinkPreviews(entry),
  })),
)

const sections = rendered.map(({ entry, headings }, i) => ({
  id: i === 0 ? undefined : subpostSlug(entry.id),
  label: entry.data.title,
  open: entry.id === post.id,
  headings: headings.filter(
    ({ depth, text }) => depth >= 2 && depth <= 4 && text.trim(),
  ),
}))
const hasToc =
  sections.length > 1 || sections.some(({ headings }) => headings.length > 0)

const crumbs: { label: string; href: string }[] = []
if (chain.length > 1) {
  crumbs.push({
    label: titleText(parent.data.title),
    href: `/posts/${parent.id}/`,
  })
  if (isSubpost(post.id)) {
    crumbs.push({
      label: titleText(post.data.title),
      href: `/posts/${post.id}/`,
    })
  }
}
const isThoughts = post.id === "i-hate-my-thoughts-posts"
const isSiri = post.id === "siri-linux-minecraft"
---

<Layout crumbs={crumbs} reading>
  <Fragment slot="head">
    <MetaPost
      post={post}
      canonical={isSubpost(post.id) ? `/posts/${parent.id}/` : undefined}
    />
    {isThoughts && <link rel="stylesheet" href={thoughtsCss} />}
    {isSiri && <link rel="stylesheet" href={siriCss} />}
  </Fragment>
  {hasToc && (
      <TableOfContents
        slot="toc"
        title={parent.data.title}
        sections={sections}
      />
    )}
  <ScrollToTop slot="actions" />
  <ScrollToTop floating />
  <ImageViewer />
  {isSiri && (
    <>
      <SiriClock />
      <SiriDemo />
    </>
  )}
  {isThoughts && <ThoughtsMarginalia />}
  <LinkPreviews />
  <CodeTools />
  <HeadingLinks />
  <QuoteLink />
  <ResumeReading />
  {rendered.map(({ entry, Content, authors, linkPreviews }, i) => {
    const Heading = i === 0 ? "h1" : "h2"
    return (
      <article
        id={i === 0 ? "introduction" : subpostSlug(entry.id)}
        data-url={`/posts/${entry.id}/`}
        data-title={pageTitle(entry.data.title)}
        data-link-previews={JSON.stringify(linkPreviews)}
        data-embedded={i > 0 || undefined}
      >
        <header>
          <Heading
            class="post-heading"
            style={entry.id === post.id ? titleTransition(entry.id) : undefined}
            set:html={titleHtml(entry.data.title)}
          />
          <p>{entry.data.description}</p>
          <post-meta>
            {authors.length > 0 && (
              <post-authors>
                <author-avatars>
                  {authors.map((author) => (
                    <img
                      src={author.data.avatar}
                      alt=""
                      width="18"
                      height="18"
                    />
                  ))}
                </author-avatars>
                <author-names>
                  {authors.map((author, j) => (
                    <>{j > 0 && ", "}{author.data.name}</>
                  ))}
                </author-names>
              </post-authors>
            )}
            <meta-timing>
              <time
                datetime={entry.data.date.toISOString()}
                style={entry.id === post.id ? dateTransition(entry.id) : undefined}
                >{formatDate(entry.data.date)}</time
              >
              <reading-time>{readingTime(entry.body ?? "")}</reading-time>
            </meta-timing>
          </post-meta>
            {entry.data.tags && (
              <post-tags>
                {entry.data.tags.map((tag) => (
                  <a href={`/tags/${tag}/`}>#{tag}</a>
                ))}
              </post-tags>
            )}
          {entry.data.facts && (
            <dl class="fact-table">
              {entry.data.facts.event && (
                <div class="fact-row"><dt>event</dt><dd>{entry.data.facts.event}</dd></div>
              )}
              {entry.data.facts.category && (
                <div class="fact-row"><dt>category</dt><dd>{entry.data.facts.category}</dd></div>
              )}
              {entry.data.facts.target && (
                <div class="fact-row"><dt>target</dt><dd>{entry.data.facts.target}</dd></div>
              )}
              {entry.data.facts.tools && (
                <div class="fact-row"><dt>tools</dt><dd>{entry.data.facts.tools.join(", ")}</dd></div>
              )}
            </dl>
          )}
        </header>
        {entry.data.image && (
          <post-banner>
            <Image
              src={entry.data.image}
              alt=""
              width={1200}
              height={630}
              priority={entry.id === post.id || undefined}
            />
          </post-banner>
        )}
        <prose-content>
          <Content />
        </prose-content>
      </article>
    )
  })}
  <PostNavigation prev={prev} next={next} />
  {chain.length > 1 && <SeriesReader />}
</Layout>

<style>
  article[data-embedded] {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-xl);
    border-block-start: 2px solid var(--border);
    scroll-margin-block-start: calc(-2px - 0.2 * var(--step-2));

    header .post-heading {
      font-size: var(--step-2);
    }
  }

  header {
    margin-block-end: var(--space-xl);

    .post-heading {
      font-size: clamp(1.75rem, 1.2rem + 1.5vw, 2.5rem);
      line-height: 1.18;
      font-weight: var(--font-weight-medium);
      /* The cap height sits flush with the top of the header instead of
         floating in line-height air. */
      text-box: trim-start cap alphabetic;
    }

    post-meta {
      --underline: var(--muted-foreground);

      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4em 0.6em;
      margin-block-start: var(--space-m);
      font-family: var(--font-mono);
      font-size: var(--text-meta);
      letter-spacing: 0;
      color: var(--muted-foreground);

      meta-timing {
        display: inline-flex;
        align-items: center;
        gap: 0.6em;
        white-space: nowrap;
      }

      time,
      reading-time {
        font-variant-numeric: tabular-nums;
      }

      time ~ reading-time::before {
        content: "·";
        margin-inline-end: var(--space-3xs);
      }

      post-authors {
        display: flex;
        align-items: center;
        gap: var(--space-3xs);

        author-avatars {
          display: flex;
          margin-block-end: -0.1em;

          img {
            border-radius: var(--radius-full);
            box-shadow: 0 0 0 1.5px var(--background);

            &:not(:first-child) {
              margin-inline-start: -0.375rem;
            }
          }
        }
      }

      post-authors ~ meta-timing::before {
        content: "·";
      }

      @media (width < 30rem) {
        flex-direction: column;
        align-items: flex-start;

        post-authors ~ meta-timing::before {
          content: none;
        }
      }

      a {
        color: var(--foreground);
      }
    }

    > post-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0 0.85em;
      margin-block: calc(var(--space-xs) - 0.3rem) -0.3rem;

      a {
        padding-block: 0.3rem;
      }
      font-family: var(--font-mono);
      font-size: var(--text-meta);
      letter-spacing: 0;
      color: var(--muted-foreground);

      @media (hover: hover) {
        a:hover {
          color: var(--foreground);
        }
      }
    }

    > p {
      margin-block-start: var(--space-s);
      font-size: var(--step-0);
      line-height: 1.6;
      color: var(--muted-foreground);
    }

    .fact-table {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-m);
      margin-block-start: var(--space-m);
      padding-block-start: var(--space-m);
      font-size: var(--step--1);
      border-block-start: 1px solid var(--border);

      @media (width < 40rem) {
        grid-template-columns: 1fr;
        gap: var(--space-2xs);

        .fact-row {
          grid-template-columns: 5rem minmax(0, 1fr);
          align-items: baseline;
          gap: var(--space-s);
        }
      }

      .fact-row {
        display: grid;
        align-content: start;
        gap: 0.45em;
        min-width: 0;
      }

      dt {
        font-family: var(--font-mono);
        color: var(--muted-foreground);
        font-size: var(--text-caption);
        text-transform: uppercase;
        letter-spacing: var(--tracking-label);
      }

      dd {
        color: var(--foreground);
        text-wrap: pretty;
        overflow-wrap: anywhere;
      }
    }
  }

  post-banner {
    display: block;
    margin-block-end: var(--space-m);

    :global(img) {
      inline-size: 100%;
      block-size: auto;
      border-radius: var(--radius-md);
      outline: 1px solid light-dark(rgb(0 0 0 / 0.08), rgb(255 255 255 / 0.08));
      outline-offset: -1px;
    }
  }
</style>
