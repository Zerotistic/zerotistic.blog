---
import { cveUrl, duplicateProject, products } from "@/data/cves"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"

const findingCount = products
  .flatMap((product) => product.findings)
  .filter((finding) => finding.published).length
const criticalCount = products
  .flatMap((product) => product.findings)
  .filter((finding) => finding.severity === "critical").length
const duplicateFinding = duplicateProject.findings[0]
---

<Layout>
  <MetaPage
    slot="head"
    title="CVEs"
    description="A running index of CVEs discovered by zerotistic across AI infrastructure, machine-learning frameworks, and security tooling."
  />

  <nav slot="toc" class="project-nav" data-bar aria-label="Project index">
    <div class="project-board">
      <p class="index-label">
        <span class="index-title">
          <span aria-hidden="true">//</span>
          projects
        </span>
        <span class="count-label">CVEs</span>
      </p>
      <ol>
        {products.map((product, productIndex) => (
            <li>
              <a
                href={`#${product.id}`}
                aria-current={productIndex === 0 ? "location" : undefined}
              >
                <span>{product.name}</span>
                <span class="index-count" aria-label={`${product.findings.length} CVEs`}>
                  {product.findings.length.toString().padStart(2, "0")}
                </span>
              </a>
            </li>
          ))}
      </ol>
    </div>

    <div class="project-board duplicate-nav-board">
      <p class="index-label">
        <span class="index-title">
          <span aria-hidden="true">//</span>
          duplicates
        </span>
        <span class="count-label">research notes</span>
      </p>
      <ol>
        <li>
          <a href={`#${duplicateProject.id}`}>
            <span>{duplicateProject.name}</span>
            <span
              class="index-count"
              aria-label={`${duplicateProject.findings.length} duplicate finding`}
            >
              {duplicateProject.findings.length.toString().padStart(2, "0")}
            </span>
          </a>
        </li>
      </ol>
    </div>
  </nav>

  <header class="page-heading">
    <p class="eyebrow">
      <span aria-hidden="true">//</span>
      vulnerability research
    </p>
    <h1>cves</h1>
    <p class="intro">Published vulnerabilities from my security research.</p>
    <p class="pipeline-note">
      Additional findings are moving through coordinated disclosure.
    </p>
  </header>

  <dl class="stats" aria-label="CVE summary">
    <div>
      <dt>published CVEs</dt>
      <dd>{findingCount.toString().padStart(2, "0")}</dd>
    </div>
    <div>
      <dt>projects</dt>
      <dd>{products.length.toString().padStart(2, "0")}</dd>
    </div>
    <div>
      <dt>critical</dt>
      <dd>{criticalCount.toString().padStart(2, "0")}</dd>
    </div>
  </dl>

  <div class="product-index" aria-label="Vulnerabilities grouped by product">
    {products.map((product, productIndex) => (
        <section
          id={product.id}
          class="product-group"
          aria-labelledby={`${product.id}-heading`}
          style={`--group-index:${productIndex}`}
        >
          <header class="product-heading">
            <h2 id={`${product.id}-heading`}>{product.name}</h2>
            <p>
              {product.context} · {product.findings.length} {product.findings.length === 1 ? "CVE" : "CVEs"}
            </p>
          </header>

          <ol class="finding-list">
            {product.findings.map((finding) => (
                <li>
                  <article>
                    <div class="record-meta">
                      <code>{finding.id}</code>
                      {finding.score && finding.cvss && finding.severity ? (
                        <span
                          class="score"
                          data-severity={finding.severity}
                          title={`${finding.severity} severity`}
                        >
                          CVSS {finding.cvss} · {finding.score}
                        </span>
                      ) : (
                        <span class="score score-pending">CVSS pending</span>
                      )}
                    </div>
                    <h3>{finding.title}</h3>
                    <p>{finding.summary}</p>
                    <footer class="record-footer">
                      {finding.published ? (
                        <time datetime={finding.published}>{finding.published}</time>
                      ) : (
                        <span class="record-pending">publication pending</span>
                      )}
                      <div class="record-links">
                        {finding.url ? (
                          <a
                            href={finding.url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            CVE record <span aria-hidden="true">↗</span>
                          </a>
                        ) : (
                          <span class="record-pending">
                            {finding.id.includes("XXXX") ? "ID pending" : "CVE record pending"}
                          </span>
                        )}
                        {finding.advisory && (
                          <a
                            href={finding.advisory.href}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {finding.advisory.label} <span aria-hidden="true">↗</span>
                          </a>
                        )}
                      </div>
                    </footer>
                  </article>
                </li>
              ))}
          </ol>
        </section>
      ))}

    <div class="duplicate-board" aria-labelledby="duplicate-board-heading">
      <header class="board-heading">
        <h2 id="duplicate-board-heading">
          <span aria-hidden="true">//</span>
          duplicate findings
        </h2>
        <p>
          Independently discovered vulnerabilities where another report arrived
          first.
        </p>
      </header>

      <section
        id={duplicateProject.id}
        class="product-group"
        aria-labelledby={`${duplicateProject.id}-heading`}
        style={`--group-index:${products.length}`}
      >
        <header class="product-heading">
          <h3 id={`${duplicateProject.id}-heading`}>{duplicateProject.name}</h3>
          <p>{duplicateProject.context} · 1 finding</p>
        </header>

        <ol class="finding-list">
          <li>
            <article>
              <div class="record-meta">
                <code>{duplicateFinding.id}</code>
              </div>
              <h4>{duplicateFinding.title}</h4>
              <p>{duplicateFinding.summary}</p>
              <footer class="record-footer duplicate-footer">
                <div class="record-links">
                  <a href={duplicateFinding.writeup}>
                    Technical write-up <span aria-hidden="true">→</span>
                  </a>
                  <a
                    href={cveUrl(duplicateFinding.id)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    CVE record <span aria-hidden="true">↗</span>
                  </a>
                  <a
                    href={duplicateFinding.note}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Original note <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </footer>
            </article>
          </li>
        </ol>
      </section>
    </div>
  </div>

  <p class="score-note">
    Scores shown are CNA-provided base scores from the linked CVE records.
  </p>
</Layout>

<style>
  .project-nav {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0;

    .project-board + .project-board {
      margin-block-start: var(--space-m);
      padding-block-start: var(--space-m);
      border-block-start: 1px solid var(--border);
    }

    .index-label {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2xs);
      margin-block-end: var(--space-xs);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);

      .index-title > span {
        color: var(--accent);
      }
    }

    .count-label {
      font-size: 0.8em;
      font-weight: var(--font-weight-normal);
      text-transform: uppercase;
      color: var(--muted-foreground);
    }

    ol {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
    }

    a {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2xs);
      color: var(--muted-foreground);
      text-decoration-line: none;

      &:hover,
      &[aria-current] {
        color: var(--foreground);
      }
    }

    .index-count {
      font-variant-numeric: tabular-nums;
    }

    .index-count {
      opacity: 0.55;
    }

    @media (width < 64rem) {
      display: flex;
      align-items: center;
      gap: var(--space-l);
      min-inline-size: 0;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }

      .project-board {
        display: flex;
        flex: none;
        align-items: center;
        gap: var(--space-s);
      }

      .project-board + .project-board {
        margin-block-start: 0;
        padding-block-start: 0;
        padding-inline-start: var(--space-l);
        border-block-start: 0;
        border-inline-start: 1px solid var(--border);
      }

      .index-label {
        flex: none;
        display: block;
        margin-block-end: 0;
      }

      .count-label {
        display: none;
      }

      ol {
        flex: none;
        flex-direction: row;
        gap: var(--space-s);
      }

      li {
        flex: none;
      }

      a {
        display: inline-flex;
        gap: var(--space-3xs);
        white-space: nowrap;
      }

      .index-count {
        display: none;
      }
    }
  }

  .page-heading {
    margin-block-end: var(--space-l);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    .eyebrow {
      margin-block-end: var(--space-2xs);
    }

    h1 {
      font-family: var(--font-mono);
      font-size: var(--step-3);
      font-weight: var(--font-weight-medium);
      letter-spacing: 0;
      line-height: calc(var(--leading-offset) + 1em);
    }

    .intro {
      max-inline-size: 38rem;
      margin-block-start: var(--space-s);
      font-size: var(--step-0);
      color: var(--prose-foreground);
    }

    .pipeline-note {
      display: flex;
      align-items: baseline;
      gap: var(--space-2xs);
      margin-block-start: var(--space-s);
      font-family: var(--font-mono);
      font-size: var(--step--1);
      letter-spacing: 0;
      color: var(--muted-foreground);

      &::before {
        content: "";
        flex: none;
        inline-size: 0.42rem;
        block-size: 0.42rem;
        border-radius: var(--radius-full);
        background-color: var(--accent);
      }
    }
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0;
    color: var(--muted-foreground);

    span {
      color: var(--accent);
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-block-end: var(--space-xl);
    border-block: 1px solid var(--border);

    div {
      display: flex;
      flex-direction: column-reverse;
      gap: var(--space-3xs);
      padding-block: var(--space-s);

      & + div {
        padding-inline-start: var(--space-s);
        border-inline-start: 1px solid var(--border);
      }
    }

    dt {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      letter-spacing: 0;
      color: var(--muted-foreground);
    }

    dd {
      font-family: var(--font-mono);
      font-size: var(--step-2);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0;
      color: var(--foreground);
    }
  }

  .product-index {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .product-group {
    scroll-margin-block-start: calc(
      var(--bar-nav-height, 0px) +
      var(--bar-toc-height, 0px) +
      var(--space-s)
    );
    animation: group-in 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--group-index) * 55ms);
  }

  .product-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-end: var(--space-xs);

    h2 {
      font-family: var(--font-mono);
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
      letter-spacing: 0;
    }

    p {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      letter-spacing: 0;
      text-align: end;
      color: var(--muted-foreground);
    }

    @media (width < 34rem) {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-3xs);

      p {
        text-align: start;
      }
    }
  }

  .finding-list {
    border-block-start: 1px solid var(--border);

    li {
      border-block-end: 1px solid var(--border);
    }

    article {
      padding-block: var(--space-s);
      transition: padding-inline 0.25s cubic-bezier(0.22, 1, 0.36, 1);

      &:has(a:hover),
      &:has(a:focus-visible) {
        padding-inline: var(--space-2xs);
      }
    }

    .record-meta,
    .record-footer,
    .record-links {
      display: flex;
      align-items: center;
    }

    .record-meta {
      justify-content: space-between;
      gap: var(--space-s);
    }

    code,
    .score,
    time,
    .record-links {
      font-family: var(--font-mono);
      font-size: var(--step--1);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0;
    }

    code {
      color: var(--foreground);
    }

    .score {
      white-space: nowrap;

      &::before {
        content: "";
        display: inline-block;
        inline-size: 0.42rem;
        block-size: 0.42rem;
        margin-inline-end: var(--space-3xs);
        border-radius: var(--radius-full);
        background-color: currentColor;
        vertical-align: 0.08em;
      }

      &[data-severity="critical"] {
        color: var(--destructive);
      }

      &[data-severity="high"] {
        color: color-mix(in oklab, var(--destructive) 62%, var(--foreground));
      }

      &[data-severity="medium"] {
        color: var(--muted-foreground);
      }

      &.score-pending {
        color: var(--muted-foreground);
      }
    }

    h3,
    h4 {
      margin-block-start: var(--space-2xs);
      font-size: var(--step-0);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
    }

    article > p {
      max-inline-size: 38rem;
      margin-block-start: var(--space-3xs);
      color: var(--prose-foreground);
    }

    .record-footer {
      justify-content: space-between;
      gap: var(--space-s);
      margin-block-start: var(--space-xs);
      color: var(--muted-foreground);
    }

    .duplicate-footer {
      justify-content: flex-end;
    }

    .record-links {
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: var(--space-s);

      a {
        color: var(--muted-foreground);

        &:hover {
          color: var(--foreground);
        }

        span {
          color: var(--accent);
        }
      }

      .record-pending {
        color: var(--muted-foreground);
      }
    }

    @media (width < 32rem) {
      .record-meta,
      .record-footer {
        align-items: flex-start;
        flex-direction: column;
        gap: var(--space-2xs);
      }

      .record-links {
        justify-content: flex-start;
      }
    }
  }

  .duplicate-board {
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--border);

    .board-heading {
      margin-block-end: var(--space-l);

      h2 {
        font-family: var(--font-mono);
        font-size: var(--step-0);
        font-weight: var(--font-weight-medium);
        letter-spacing: 0;
        color: var(--foreground);

        span {
          color: var(--accent);
        }
      }

      p {
        max-inline-size: 38rem;
        margin-block-start: var(--space-3xs);
        color: var(--muted-foreground);
      }
    }

    .product-heading h3 {
      margin-block-start: 0;
      font-family: var(--font-mono);
      font-size: var(--step-1);
      letter-spacing: 0;
    }
  }

  .score-note {
    margin-block-start: var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0;
    color: var(--muted-foreground);
  }

  @keyframes group-in {
    from {
      opacity: 0;
      translate: 0 0.5rem;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-group {
      animation: none;
    }

    .finding-list article {
      transition: none;
    }
  }
</style>

<script>
  const projectNav = document.querySelector<HTMLElement>(".project-nav")

  if (projectNav) {
    const mobile = matchMedia("(width < 64rem)")
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)")
    const links = new Map(
      [...projectNav.querySelectorAll<HTMLAnchorElement>("a[href^='#']")].map(
        (link) => [decodeURIComponent(link.hash.slice(1)), link],
      ),
    )

    const setActive = (id: string) => {
      for (const [projectId, link] of links) {
        if (projectId === id) link.setAttribute("aria-current", "location")
        else link.removeAttribute("aria-current")
      }

      const activeLink = links.get(id)
      if (!mobile.matches || !activeLink) return

      const listBounds = projectNav.getBoundingClientRect()
      const linkBounds = activeLink.getBoundingClientRect()
      if (
        linkBounds.left < listBounds.left ||
        linkBounds.right > listBounds.right
      ) {
        projectNav.scrollTo({
          left: projectNav.scrollLeft + linkBounds.left - listBounds.left - 12,
          behavior: reducedMotion.matches ? "auto" : "smooth",
        })
      }
    }

    const hashId = decodeURIComponent(location.hash.slice(1))
    if (links.has(hashId)) setActive(hashId)

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id)
        }
      },
      { rootMargin: "-15% 0px -70% 0px" },
    )

    for (const id of links.keys()) {
      const section = document.getElementById(id)
      if (section) observer.observe(section)
    }
  }
</script>
