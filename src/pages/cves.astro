---
import { cveUrl, duplicateProject, products } from "@/data/cves"
import MetaPage from "@/components/MetaPage.astro"
import CveFinding from "@/components/CveFinding.astro"
import Layout from "@/layouts/Layout.astro"

const findingCount = products
  .flatMap((product) => product.findings)
  .filter((finding) => finding.published).length
const criticalCount = products
  .flatMap((product) => product.findings)
  .filter((finding) => finding.severity === "critical").length
const duplicateFinding = duplicateProject.findings[0]
const findingAnchor = (id: string, product: string) =>
  id.includes("XXXX") ? `${product}-pending` : id.toLowerCase()
---

<Layout reading narrowToc>
  <MetaPage
    slot="head"
    title="CVEs"
    description="A running index of CVEs discovered by zerotistic across AI infrastructure, machine-learning frameworks, and security tooling."
  />

  <div slot="toc" class="project-navigation">
    <div class="project-picker" data-bar hidden>
      <label for="project-picker">Project</label>
      <div class="select-wrap">
        <select id="project-picker" aria-label="Jump to project">
          <optgroup label="Published findings">
            {products.map((product) => (
              <option value={product.id}>{product.name} · {product.findings.length}</option>
            ))}
          </optgroup>
          <optgroup label="Duplicate findings">
            <option value={duplicateProject.id}>
              {duplicateProject.name}
              · 1
            </option>
          </optgroup>
        </select>
        <svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="m4 6 4 4 4-4" />
        </svg>
      </div>
    </div>

    <nav class="project-nav" data-bar aria-label="Project index">
      <div class="project-board">
        <p class="index-label">
          <span
            ><span class="index-mark" aria-hidden="true">//</span>
            projects</span
          >
          <span class="count-label">findings</span>
        </p>
        <ol>
          {products.map((product, productIndex) => (
            <li>
              <a href={`#${product.id}`} aria-current={productIndex === 0 ? "location" : undefined}>
                <span>{product.name}</span>
                <span class="index-count" aria-label={`${product.findings.length} findings`}>
                  {product.findings.length.toString().padStart(2, "0")}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <div class="project-board duplicate-nav-board">
        <p class="index-label">
          <span
            ><span class="index-mark" aria-hidden="true">//</span>
            duplicates</span
          >
        </p>
        <ol>
          <li>
            <a href={`#${duplicateProject.id}`}>
              <span>{duplicateProject.name}</span>
              <span class="index-count" aria-label="1 duplicate finding"
                >01</span
              >
            </a>
          </li>
        </ol>
      </div>
    </nav>
  </div>

  <header class="page-heading">
    <p class="eyebrow">
      <span aria-hidden="true">//</span>
      vulnerability research
    </p>
    <h1>cves</h1>
    <p class="intro">Published vulnerabilities from my security research.</p>
    <p class="pipeline-note">
      Additional findings are moving through coordinated disclosure.
    </p>
  </header>

  <dl class="stats" aria-label="CVE summary">
    <div>
      <dt>published</dt>
      <dd>{findingCount.toString().padStart(2, "0")}</dd>
    </div>
    <div>
      <dt>projects</dt>
      <dd>{products.length.toString().padStart(2, "0")}</dd>
    </div>
    <div>
      <dt>critical</dt>
      <dd>{criticalCount.toString().padStart(2, "0")}</dd>
    </div>
  </dl>

  <div class="product-index" aria-label="Vulnerabilities grouped by product">
    {products.map((product) => (
      <section id={product.id} class="product-group" aria-labelledby={`${product.id}-heading`}>
        <header class="product-heading">
          <h2 id={`${product.id}-heading`}>{product.name}<span class="product-count" aria-label={`${product.findings.length} findings`}>{product.findings.length.toString().padStart(2, "0")}</span></h2>
          <p>{product.context}</p>
        </header>
        <ol class="finding-list" role="list">
          {product.findings.map((finding) => (
            <li><CveFinding finding={finding} anchor={findingAnchor(finding.id, product.id)} /></li>
          ))}
        </ol>
      </section>
    ))}

    <div class="duplicate-board" aria-labelledby="duplicate-board-heading">
      <header class="board-heading">
        <h2 id="duplicate-board-heading">
          <span aria-hidden="true">//</span>
          duplicate findings
        </h2>
        <p>
          Independently discovered vulnerabilities where another report arrived
          first.
        </p>
      </header>
      <section
        id={duplicateProject.id}
        class="product-group"
        aria-labelledby={`${duplicateProject.id}-heading`}
      >
        <header class="product-heading">
          <h3 id={`${duplicateProject.id}-heading`}>
            {duplicateProject.name}
            <span class="product-count" aria-label="1 finding">01</span>
          </h3>
          <p>{duplicateProject.context}</p>
        </header>
        <ol class="finding-list" role="list">
          <li>
            <CveFinding
              finding={{ ...duplicateFinding, url: cveUrl(duplicateFinding.id) }}
              heading="h4"
              writeup={duplicateFinding.writeup}
              note={duplicateFinding.note}
            />
          </li>
        </ol>
      </section>
    </div>
  </div>

  <p class="score-note">
    Scores shown are published base scores from the linked vulnerability
    records.
  </p>
</Layout>

<style>
  .project-navigation {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0;
    max-block-size: 100%;
    overflow-y: auto;
  }

  .project-picker {
    display: none;
  }

  .project-nav {
    padding-inline-start: var(--space-2xs);

    .project-board + .project-board {
      margin-block-start: var(--space-m);
      padding-block-start: var(--space-m);
      border-block-start: 1px solid var(--border);
    }

    .index-label {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-3xs);
      margin-block-end: var(--space-xs);
      font-weight: var(--font-weight-medium);
    }

    .index-mark {
      color: var(--accent);
    }

    .count-label {
      font-size: 0.6875rem;
      font-weight: var(--font-weight-normal);
      text-transform: uppercase;
      color: var(--muted-foreground);
    }

    ol {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
    }

    a {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      gap: var(--space-2xs);
      margin-inline-start: calc(-1 * var(--space-2xs));
      padding: var(--space-3xs) var(--space-2xs);
      border-inline-start: 2px solid transparent;
      color: var(--muted-foreground);
      text-decoration: none;
      font-size: 0.875rem;
      transition: background-color 0.15s ease;

      &:hover {
        color: var(--foreground);
        background-color: color-mix(in oklab, var(--muted) 45%, transparent);
      }

      &[aria-current] {
        border-inline-start-color: var(--accent);
        background-color: color-mix(in oklab, var(--accent) 9%, transparent);
        color: var(--foreground);
      }
    }

    .index-count {
      font-variant-numeric: tabular-nums;
      color: var(--muted-foreground);
    }
  }

  .page-heading {
    margin-block-end: var(--space-s);

    .eyebrow {
      margin-block-end: var(--space-3xs);
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      color: var(--muted-foreground);

      span {
        color: var(--accent);
      }
    }

    h1 {
      font-family: var(--font-mono);
      font-size: var(--step-3);
      font-weight: var(--font-weight-medium);
      letter-spacing: 0;
      line-height: 1.2;
    }

    .intro {
      margin-block-start: var(--space-2xs);
      color: var(--prose-foreground);
    }

    .pipeline-note {
      display: flex;
      align-items: baseline;
      gap: var(--space-2xs);
      margin-block-start: var(--space-2xs);
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      color: var(--muted-foreground);

      &::before {
        content: "";
        flex: none;
        inline-size: 0.3rem;
        block-size: 0.3rem;
        border-radius: var(--radius-full);
        background-color: var(--accent);
      }
    }
  }

  .stats {
    display: flex;
    align-items: center;
    margin-block-end: var(--space-l);
    padding-block: var(--space-xs);
    border-block: 1px solid var(--border);

    div {
      display: flex;
      align-items: baseline;
      gap: var(--space-2xs);

      & + div {
        margin-inline-start: var(--space-m);
        padding-inline-start: var(--space-m);
        border-inline-start: 1px solid var(--border);
      }
    }

    dt {
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      color: var(--muted-foreground);
    }

    dd {
      order: -1;
      font-family: var(--font-mono);
      font-size: var(--step-1);
      font-variant-numeric: tabular-nums;
    }
  }

  .product-index {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .product-group {
    scroll-margin-block-start: var(--space-s);
  }

  .product-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-end: var(--space-xs);

    h2,
    h3 {
      display: flex;
      align-items: baseline;
      gap: var(--space-2xs);
      font-family: var(--font-mono);
      font-size: var(--step-1);
      font-weight: var(--font-weight-medium);
      letter-spacing: 0;
    }

    .product-count {
      font-size: 0.75rem;
      font-weight: var(--font-weight-normal);
      font-variant-numeric: tabular-nums;
      color: var(--muted-foreground);
    }

    p {
      font-family: var(--font-mono);
      font-size: 0.8125rem;
      color: var(--muted-foreground);
      text-align: end;
    }
  }

  .finding-list {
    border-block-start: 1px solid var(--border);

    li {
      border-block-end: 1px solid var(--border);
    }
  }

  .duplicate-board {
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--border);

    .board-heading {
      margin-block-end: var(--space-m);

      h2 {
        font: var(--font-weight-medium) var(--step--1) var(--font-mono);

        span {
          color: var(--accent);
        }
      }

      p {
        max-inline-size: 65ch;
        margin-block-start: var(--space-3xs);
        color: var(--muted-foreground);
      }
    }
  }

  .score-note {
    margin-block-start: var(--space-s);
    font: 0.8125rem / 1.5 var(--font-mono);
    color: var(--muted-foreground);
  }

  @media (width < 64rem) {
    :global(html:has(.project-navigation)) {
      --bar-toc-height: calc(2.75rem + 2px);
    }

    .project-navigation {
      overflow: visible;
    }

    .project-picker {
      display: flex;
      align-items: center;
      gap: var(--space-s);
      padding-block: 0;
      font-size: 0.8125rem;

      label {
        flex: none;
        color: var(--muted-foreground);
      }

      .select-wrap {
        position: relative;
        flex: 1;
        min-inline-size: 0;
      }

      select {
        display: block;
        inline-size: 100%;
        min-block-size: 2.75rem;
        padding-inline: var(--space-2xs) var(--space-m);
        cursor: pointer;
        appearance: none;
        background-color: var(--background);
        color: var(--foreground);
      }

      svg {
        position: absolute;
        inset-inline-end: var(--space-3xs);
        inset-block-start: 50%;
        translate: 0 -50%;
        inline-size: 1rem;
        block-size: 1rem;
        color: var(--accent);
        pointer-events: none;
      }
    }

    .project-navigation:has(.project-picker:not([hidden])) .project-nav {
      display: none;
    }

    /* Keep anchor navigation available when JavaScript is disabled. */
    .project-nav,
    .project-nav .project-board,
    .project-nav ol {
      display: flex;
      align-items: center;
      flex-direction: row;
      gap: var(--space-s);
    }

    .project-nav {
      overflow-x: auto;

      .project-board {
        flex: none;
      }

      .project-board + .project-board {
        margin: 0;
        padding: 0;
        border: 0;
      }

      .index-label {
        margin: 0;
      }

      .count-label,
      .index-count {
        display: none;
      }

      a {
        min-block-size: 2.75rem;
        align-items: center;
        white-space: nowrap;
      }
    }
  }

  @media (width < 40rem) {
    .stats {
      justify-content: space-between;

      div {
        gap: var(--space-3xs);

        & + div {
          margin-inline-start: var(--space-2xs);
          padding-inline-start: var(--space-2xs);
        }
      }

      dt {
        font-size: 0.75rem;
      }
    }

    .product-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-3xs);

      p {
        text-align: start;
      }
    }
  }
</style>

<script>
  const projectNav = document.querySelector<HTMLElement>(".project-nav")
  const picker = document.querySelector<HTMLSelectElement>("#project-picker")
  const pickerBar = document.querySelector<HTMLElement>(".project-picker")

  if (projectNav && picker && pickerBar) {
    pickerBar.hidden = false
    const mobile = matchMedia("(width < 64rem)")
    const links = [
      ...projectNav.querySelectorAll<HTMLAnchorElement>("a[href^='#']"),
    ]
    const sections = links.flatMap((link) => {
      const section = document.getElementById(link.hash.slice(1))
      return section ? [{ link, section }] : []
    })

    const updateActiveProject = () => {
      const offset =
        (mobile.matches ? pickerBar.getBoundingClientRect().height : 0) + 32
      let active = sections[0]
      for (const entry of sections) {
        if (entry.section.getBoundingClientRect().top <= offset) active = entry
      }
      if (scrollY + innerHeight >= document.documentElement.scrollHeight - 2) {
        active = sections.at(-1) ?? active
      }
      if (!active) return
      for (const { link } of sections) {
        if (link === active.link) link.setAttribute("aria-current", "location")
        else link.removeAttribute("aria-current")
      }
      picker.value = active.section.id
    }

    let scheduled = false
    const scheduleUpdate = () => {
      if (scheduled) return
      scheduled = true
      requestAnimationFrame(() => {
        scheduled = false
        updateActiveProject()
      })
    }

    picker.addEventListener("change", () => {
      const id = picker.value
      if (location.hash === `#${id}`) {
        document.getElementById(id)?.scrollIntoView({ block: "start" })
      } else {
        location.hash = id
      }
    })

    addEventListener("scroll", scheduleUpdate, { passive: true })
    addEventListener("resize", scheduleUpdate)
    addEventListener("hashchange", scheduleUpdate)
    document.addEventListener("toggle", scheduleUpdate, true)
    document.fonts.ready.then(scheduleUpdate)
    scheduleUpdate()
  }
</script>
