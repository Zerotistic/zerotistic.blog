---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getTags } from "@/lib/content"

const tags = await getTags()
---

<Layout crumbs={[{ label: "Tags", href: "/tags" }]}>
  <MetaPage slot="head" title="Tags" noindex />
  <page-heading>
    <h1>tags</h1>
    <p>{[...tags].length} tags across the archive.</p>
  </page-heading>
  <ul>
    {[...tags].map(([tag, posts]) => (
        <li>
          <a href={`/tags/${tag}`}>#{tag}<tag-count>{posts.length}</tag-count></a>
        </li>
      ))}
  </ul>
</Layout>

<style>
  page-heading {
    display: block;
    margin-block-end: var(--space-l);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    h1 {
      font-family: var(--font-mono);
      font-size: var(--step-2);
      font-weight: var(--font-weight-medium);
      letter-spacing: 0;
      line-height: calc(var(--leading-offset) + 1em);
    }

    p {
      margin-block-start: var(--space-2xs);
      font-family: var(--font-mono);
      font-size: var(--step--1);
      letter-spacing: 0;
      color: var(--muted-foreground);
    }
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);

    a {
      display: inline-block;
      padding-inline: var(--space-2xs);
      font-family: var(--font-mono);
      font-size: var(--step--1);
      letter-spacing: 0;
      color: var(--muted-foreground);
      background-color: color-mix(in oklab, var(--muted) 50%, transparent);
      border: 1px solid transparent;
      border-radius: var(--radius-full);
      text-decoration-line: none;
      transition:
        color 0.15s ease,
        border-color 0.15s ease;

      &:hover {
        color: var(--accent);
        border-color: var(--accent-muted);
      }

      tag-count {
        margin-inline-start: var(--space-3xs);
        font-variant-numeric: tabular-nums;
        opacity: 0.6;
      }
    }
  }
</style>
