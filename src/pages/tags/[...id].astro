---
import MetaPage from "@/components/MetaPage.astro"
import PostRow from "@/components/PostRow.astro"
import Layout from "@/layouts/Layout.astro"
import { getSubposts, getTags } from "@/lib/content"
import type { CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const tags = await getTags()
  return [...tags].map(([tag, posts]) => ({
    params: { id: tag },
    props: { tag, posts },
  }))
}

type Props = { tag: string; posts: CollectionEntry<"blog">[] }

const { tag, posts } = Astro.props
const series = await getSubposts()
---

<Layout
  crumbs={[
    { label: "Tags", href: "/tags" },
    { label: `#${tag}`, href: `/tags/${tag}` },
  ]}
>
  <MetaPage
    slot="head"
    title={`Posts tagged "${tag}"`}
    description={`A collection of posts tagged with ${tag}.`}
    noindex
  />
  <page-heading>
    <h1>#{tag}</h1>
    <p>
      {posts.length}
      {posts.length === 1 ? "post" : "posts"}
    </p>
  </page-heading>
  <ol>
    {posts.map((post) => (
        <PostRow
          post={post}
          partCount={(series.get(post.id) ?? []).length}
          tags={[]}
        />
      ))}
  </ol>
</Layout>

<style>
  page-heading {
    display: block;
    margin-block-end: var(--space-l);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    h1 {
      font-family: var(--font-mono);
      font-size: var(--step-2);
      font-weight: var(--font-weight-medium);
      letter-spacing: 0;
      line-height: calc(var(--leading-offset) + 1em);
    }

    p {
      margin-block-start: var(--space-2xs);
      font-family: var(--font-mono);
      font-size: var(--step--1);
      letter-spacing: 0;
      color: var(--muted-foreground);
    }
  }

  ol {
    display: block;
    list-style: none;
  }
</style>
