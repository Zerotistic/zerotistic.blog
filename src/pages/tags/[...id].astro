---
import MetaPage from "@/components/MetaPage.astro"
import PageHeader from "@/components/PageHeader.astro"
import PostPeek from "@/components/PostPeek.astro"
import PostRow from "@/components/PostRow.astro"
import Layout from "@/layouts/Layout.astro"
import { getSubposts, getTags } from "@/lib/content"
import { readingTime } from "@/lib/utils"
import type { CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const tags = await getTags()
  return [...tags].map(([tag, posts]) => ({
    params: { id: tag },
    props: { tag, posts },
  }))
}

type Props = { tag: string; posts: CollectionEntry<"blog">[] }

const { tag, posts } = Astro.props
const series = await getSubposts()
---

<Layout wide crumbs={[{ label: `#${tag}`, href: `/tags/${tag}/` }]}>
  <MetaPage
    slot="head"
    title={`Posts tagged "${tag}"`}
    description={`A collection of posts tagged with ${tag}.`}
    noindex
  />
  <PageHeader
    title={`#${tag}`}
    description={`${posts.length} ${posts.length === 1 ? "post" : "posts"}`}
  />
  <ol>
    {posts.map((post) => {
      const parts = series.get(post.id) ?? []
      return (
        <PostRow
          post={post}
          partCount={parts.length}
          readTime={readingTime(
            [post, ...parts].map((entry) => entry.body ?? "").join("\n"),
          )}
        />
      )
    })}
  </ol>
  <PostPeek />
</Layout>

<style>
  ol {
    display: block;
    list-style: none;
  }
</style>
