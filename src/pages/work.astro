---
import MetaPage from "@/components/MetaPage.astro"
import PageHeader from "@/components/PageHeader.astro"
import WorkJumpingCheer from "@/components/WorkJumpingCheer.astro"
import { education, work } from "@/data/work"
import Layout from "@/layouts/Layout.astro"
import { formatWorkDate } from "@/lib/work"
---

<Layout showArtoria={false} wide>
  <MetaPage
    slot="head"
    title="Work"
    description="Experience and education. HiddenLayer, Hackcyom, Deloitte, and École 2600."
  />

  <div class="work-page">
    <PageHeader title="work" description="Experience & education." />

    <div class="work-history">
      <ol
        class="work-list"
        role="list"
        aria-label="Work experience, newest first"
      >
        {work.map((entry) => {
          const current = !entry.end
          const fullTime = entry.phases?.find((phase) => phase.label === "Full-time")
          return (
            <li class:list={["work-entry", { current, "has-phases": !!fullTime }]}>
              <article
                class="entry-content"
                aria-labelledby={`${entry.id}-heading`}
                aria-describedby={entry.kind === "Apprenticeship" ? "education-connection" : undefined}
              >
                <div class="entry-summary">
                  <div class:list={["entry-logo", `entry-logo-${entry.id}`]} aria-hidden="true">
                    <img src={entry.logo} width="40" height="40" alt="" decoding="async" />
                  </div>
                  <div class="entry-copy">
                    <h2 id={`${entry.id}-heading`}>{entry.organization}</h2>
                    <p class="entry-role">
                      {entry.role}
                      {entry.kind === "Apprenticeship" && <span class="entry-kind"> · Apprenticeship</span>}
                    </p>
                    <div class="entry-meta">
                      <p class="date-range">
                        <time datetime={entry.start}>{formatWorkDate(entry.start)}</time>
                        <span aria-hidden="true">—</span>
                        {entry.end ? (
                          <time datetime={entry.end}>{formatWorkDate(entry.end)}</time>
                        ) : (
                          <span>Present</span>
                        )}
                      </p>
                      {entry.location && <p class="entry-location">{entry.location}</p>}
                    </div>
                  </div>
                  {current && <div class="current-companion"><WorkJumpingCheer /></div>}
                </div>
                {fullTime && (
                  <p class="entry-note" aria-describedby="education-connection">
                    I joined as an apprentice and went full-time {fullTime.approximateStart ? "around " : "in "}
                    <time datetime={fullTime.start}>{new Date(`${fullTime.start}-01T00:00:00Z`).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" })}</time>.
                  </p>
                )}
              </article>
            </li>
          )
        })}
      </ol>

      <aside class="education" aria-labelledby="ecole-2600-heading">
        <div class="education-bracket" aria-hidden="true"></div>
        <div class="education-details">
          <p class="education-label">alongside work</p>
          <div class="education-heading">
            <div class="entry-logo entry-logo-ecole-2600" aria-hidden="true">
              <img
                src={education.logo}
                width="32"
                height="32"
                alt=""
                decoding="async"
              >
            </div>
            <h2 id="ecole-2600-heading">{education.organization}</h2>
          </div>
          <p class="education-role">{education.role}</p>
          <p class="education-dates">
            <time datetime={education.start}
              >{formatWorkDate(education.start)}</time
            >
            {" — "}{education.approximateEnd && "around "}
            <time datetime={education.end}
              >{formatWorkDate(education.end!)}</time
            >
          </p>
          <p class="education-connection" id="education-connection">
            Studied while apprenticing at Deloitte, then Hackcyom.
          </p>
          <p class="education-note">{education.note}</p>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .work-page {
    --logo-size: 2.5rem;
    --entry-gap: var(--space-s);
  }

  .work-history {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16.5rem;
    grid-template-rows: [current] auto [hackcyom] auto [apprenticeship] auto [deloitte] auto [end];
    column-gap: var(--space-m);
  }

  .work-list {
    display: grid;
    grid-column: 1;
    grid-row: current / end;
    grid-template-rows: subgrid;
    min-inline-size: 0;
    list-style: none;
  }

  .work-entry {
    position: relative;
    display: grid;
    grid-template-rows: subgrid;
    min-inline-size: 0;
    padding-block: var(--space-m);

    &::before {
      content: "";
      position: absolute;
      inset-inline-start: calc(var(--logo-size) / 2);
      inset-block-start: calc(
        var(--space-m) +
        var(--logo-size) +
        var(--space-2xs)
      );
      inset-block-end: calc(var(--space-2xs) - var(--space-m));
      inline-size: 1px;
      background: var(--border);
      pointer-events: none;
    }

    &:first-child {
      padding-block-start: 0;

      &::before {
        inset-block-start: calc(var(--logo-size) + var(--space-2xs));
      }
    }

    &.current::before {
      background: linear-gradient(var(--accent), var(--border));
    }

    &:last-child::before {
      display: none;
    }

    &.has-phases {
      grid-row: span 2;
    }
  }

  .entry-content {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: 1 / -1;
    min-inline-size: 0;
  }

  .entry-summary {
    position: relative;
    display: grid;
    grid-template-columns: var(--logo-size) minmax(0, 1fr);
    align-content: start;
    gap: var(--entry-gap);
  }

  .entry-copy {
    min-inline-size: 0;
  }

  .current .entry-summary {
    --cheer-size: 6.5rem;
    padding-inline-end: calc(var(--cheer-size) + var(--space-s));
    min-block-size: 8rem;
  }

  .current-companion {
    position: absolute;
    inset-block-start: -1.25rem;
    inset-inline-end: 0;
    inline-size: var(--cheer-size);
  }

  .entry-logo {
    inline-size: var(--logo-size);
    block-size: var(--logo-size);
    padding: 0.3125rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: #fff;

    img {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      object-fit: contain;
    }
  }

  .entry-logo-hiddenlayer {
    background: #07151e;
  }

  h2 {
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
  }

  .entry-role {
    margin-block-start: var(--space-3xs);
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--prose-foreground);
  }

  .entry-kind {
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3xs) var(--space-s);
    margin-block-start: var(--space-xs);
    color: var(--muted-foreground);
    font-size: var(--text-meta);
    line-height: 1.6;
  }

  .date-range {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;

    time {
      white-space: nowrap;
    }
  }

  .entry-note {
    margin-inline-start: calc(var(--logo-size) + var(--entry-gap));
    padding-block-start: var(--space-xs);
    max-inline-size: 29rem;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--prose-foreground);
  }

  .education {
    /* Connect the apprenticeship note and Deloitte, not Hackcyom's full-time role. */
    display: grid;
    grid-column: 2;
    grid-row: apprenticeship / end;
    grid-template-columns: 0.75rem minmax(0, 1fr);
    gap: var(--space-xs);
    padding-block: var(--space-xs) var(--space-m);
    min-inline-size: 0;
  }

  .education-bracket {
    border-block: 1px solid;
    border-inline-end: 1px solid;
    border-color: color-mix(in oklab, var(--accent) 65%, var(--border));
  }

  .education-details {
    align-self: center;
    min-inline-size: 0;
  }

  .education-label {
    margin-block-end: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--accent);
    letter-spacing: 0;
  }

  .education-heading {
    display: flex;
    align-items: center;
    gap: var(--space-xs);

    .entry-logo {
      flex-shrink: 0;
      inline-size: 2rem;
      block-size: 2rem;
      padding: 0.25rem;
      border-radius: 0.375rem;
    }

    h2 {
      font-size: var(--step-1);
    }
  }

  .education-role {
    margin-block-start: var(--space-xs);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--prose-foreground);
  }

  .education-dates,
  .education-note {
    margin-block-start: var(--space-2xs);
    font-size: var(--text-meta);
    line-height: 1.6;
    color: var(--muted-foreground);
  }

  .education-note {
    margin-block-start: var(--space-xs);
  }

  .education-connection {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (48rem <= width < 75rem) {
    .work-history {
      grid-template-columns: minmax(0, 1fr) 14rem;
      column-gap: var(--space-s);
    }

    .current .entry-summary {
      --cheer-size: 5.5rem;
    }
  }

  @media (width < 48rem) {
    .work-history {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: [current] auto [hackcyom] auto [apprenticeship] auto [deloitte] auto [end] auto [education-end];
    }

    .education {
      grid-column: 1;
      grid-row: end / education-end;
      margin-inline-start: calc(var(--logo-size) + var(--entry-gap));
      padding-block: 0;
    }

    .education-bracket {
      align-self: start;
      block-size: 2rem;
      margin-block-start: -1rem;
      border: 0;
      border-inline-start: 1px solid;
      border-block-end: 1px solid;
      border-color: color-mix(in oklab, var(--accent) 65%, var(--border));
      border-end-start-radius: 0.5rem;
    }

    .education-details {
      align-self: start;
    }
  }

  @media (width < 40rem) {
    .work-page {
      --logo-size: 2.25rem;
      --entry-gap: var(--space-xs);
    }

    .current .entry-summary {
      --cheer-size: clamp(4.5rem, 20vw, 5.25rem);
      min-block-size: 7rem;
    }

    .current-companion {
      inset-block-start: -0.75rem;
    }

    h2 {
      font-size: var(--step-1);
    }
  }
</style>
